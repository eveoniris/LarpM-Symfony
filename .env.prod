# App config
APP_ENV=prod
APP_DEBUG=0
# APP_SECRET must be set in .env.prod.local on the server (never commit it)

# Web config
DEFAULT_URI=https://larpmanager.eveoniris.com
CORS_ALLOW_ORIGIN='^https://larpmanager\.eveoniris\.com$'

JWT_SECRET_KEY=
JWT_PUBLIC_KEY=
JWT_PASSPHRASE=

# Webserver config
SERVER_NAME=":80, :443, larpmanager.eveoniris.com"

# Database config — credentials injected via GitHub Secrets (DATABASE_USER / DATABASE_PASSWORD)
# DATABASE_USER and DATABASE_PASSWORD must be set in .env.prod.local (written by deploy workflow)
DATABASE_URL=mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@REPLACE_DB_HOST:3306/REPLACE_DB_NAME?serverVersion=8.0&charset=utf8mb4

# Mailer config
MAILER_DSN=

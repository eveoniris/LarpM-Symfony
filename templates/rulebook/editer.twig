{% extends "base.html.twig" %}

{# Interface bêta (lm-design) : les composants lm-* s'ajoutent à Bootstrap, les autres comptes gardent le rendu Bootstrap. #}
{% set beta = app.user is not null and app.user.uiBeta %}

{% block title %}{{ creation ? 'Nouvelle règle' : 'Modifier ' ~ regle.code }}{% endblock title %}

{% block importmap %}{{ importmap(['app', 'rulebook-editor']) }}{% endblock %}

{% block body %}

	{% set crumbs = [{'name' : 'Rulebook', 'route' : path('rulebook.index')}] %}
	{% if not creation %}
		{% set crumbs = crumbs|merge([{'name' : regle.code, 'route' : path('rulebook.regle', {'code': regle.code})}]) %}
	{% endif %}
	{% include '_partials/breadcrumb.twig' with {'items' : crumbs|merge([{'name' : creation ? 'Nouvelle règle' : 'Modifier'}])} %}

	<header class="lm-page-head mb-3">
		<h1 class="lm-page-title h4 mb-1">{{ creation ? 'Nouvelle règle' : 'Modifier ' ~ regle.code ~ ' - ' ~ regle.titre }}</h1>
		<p class="lm-meta mb-0">
			Les textes sont en markdown pur. Les caractères invisibles et les espaces insécables collés sont retirés à l'enregistrement.
			{% if not creation %}Version actuelle : {{ regle.version }}.{% endif %}
		</p>
	</header>

	<div class="{{ beta ? 'card lm-carte-verre' : 'well well-sm' }} mb-3"><div class="{{ beta ? 'card-body' : '' }}">
	{{ form_start(form) }}
		{{ form_row(form.domaine) }}
		{{ form_row(form.code) }}
		{{ form_row(form.titre) }}
		<div class="row">
			<div class="col-12 col-md-4">{{ form_row(form.statut) }}</div>
			<div class="col-12 col-md-4">{{ form_row(form.position) }}</div>
			<div class="col-12 col-md-4">{{ form_row(form.publiee) }}</div>
		</div>
		{{ form_row(form.texteClair, {'attr': {'data-apercu-url': path('rulebook.apercu'), 'data-apercu-token': csrfApercu}}) }}
		{{ form_row(form.detailTechnique, {'attr': {'data-apercu-url': path('rulebook.apercu'), 'data-apercu-token': csrfApercu}}) }}
		{{ form_row(form.testsRefs) }}
		{{ form_row(form.motif) }}

		<div class="mb-4">
			<button type="submit" class="{{ beta ? 'lm-btn lm-btn--primary' : 'btn btn-primary' }}">Enregistrer</button>
			<a href="{{ creation ? path('rulebook.index') : path('rulebook.regle', {'code': regle.code}) }}" class="{{ beta ? 'lm-btn lm-btn--ghost' : 'btn btn-link' }}">Annuler</a>
		</div>
	{{ form_end(form) }}
	</div></div>

{% endblock body %}

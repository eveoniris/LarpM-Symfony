{% extends "base.html.twig" %}

{% block title %}Changer le mot de passe : {{ user.displayName }}{% endblock %}

{% block body %}

    {% if error %}
        <div class="alert alert-danger">{{ error|nl2br }}</div>
    {% endif %}

    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        <li><a href="{{ path('user.edit', {'user': user.id}) }}">Modifier l'utilisateur</a></li>
        <li class="active">Mot de passe</li>
    </ol>

    <div class="well well-sm">
        <div class="header">
            <h5>Changer le mot de passe : {{ user.displayName }}</h5>
        </div>

        <form class="form-horizontal" method="POST" action="{{ path('user.password', {'user': user.id}) }}" autocomplete="off">
            <input type="hidden" name="_token" value="{{ csrf_token('user-password-' ~ user.id) }}">

            {% if is_self %}
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-current-password">Mot de passe actuel</label>
                    <div class="col-sm-8">
                        <input class="form-control" name="current_password" type="password" id="input-current-password"
                               autocomplete="current-password" required>
                    </div>
                </div>
            {% endif %}

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-password">Nouveau mot de passe</label>
                <div class="col-sm-8">
                    <input class="form-control" name="password" type="password" id="input-password"
                           autocomplete="new-password" required>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-confirm-password">Confirmer le mot de passe</label>
                <div class="col-sm-8">
                    <input class="form-control" name="confirm_password" type="password" id="input-confirm-password"
                           autocomplete="new-password" required>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                    <a style="margin-left: 10px;" href="{{ path('user.edit', {'user': user.id}) }}">Retour à l'édition</a>
                </div>
            </div>
        </form>
    </div>
{% endblock %}

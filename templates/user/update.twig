{% extends "base.html.twig" %}

{% block title %}Modifier l'utilisateur : {{ user.displayName }}{% endblock %}

{% block body %}

    {% if error %}
        <div class="alert alert-danger">{{ error|nl2br }}</div>
    {% endif %}

    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        {% if is_granted('ROLE_ADMIN', app.user) %}
            <li><a href="{{ path('user.list') }}">Liste des utilisateurs</a></li>{% endif %}
        <li class="active">Modifier un utilisateur</li>
    </ol>

    <div class="well well-sm">
        <div class="header">
            <h5>Modifier l'utilisateur : {{ user.displayName }}</h5>
        </div>

        <form class="form-horizontal" method="POST" action="{{ path("user.edit", {'user': user.id}) }}">

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-name">Name</label>
                <div class="col-sm-8">
                    <input class="form-control" name="name" type="text" id="input-name" placeholder="Name"
                           value="{{ user.name }}">
                    <p class="help-block">Public</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-email">Email</label>
                <div class="col-sm-8">
                    <input class="form-control" name="email" type="email" id="input-email" placeholder="Email" required
                           value="{{ user.email }}">
                    <p class="help-block">N'est affiché qu'aux scénaristes, membre de votre groupe de jeu. Si vous êtes
                        scénariste : à vos joueurs</p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-email-contact">Email de contact</label>
                <div class="col-sm-8">
                    <input class="form-control" name="email_contact" type="email" id="input-email-contact"
                           placeholder="Email de contact" value="{{ user.emailContact }}">
                    <div class="help-block small">
                        Jamais partagé. Dans le cas où l'adresse e-mail de connexion n'est pas à privilégier pour vous
                        joindre. (Si vous
                        inscrivez un mineur: adresse du parent majeur)
                    </div>
                </div>

            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-discord-pseudo">ID Discord</label>
                <div class="col-sm-8">
                    {% if user.discordLinked %}
                        <div class="form-control-plaintext">
                            <i class="fa-brands fa-discord" aria-hidden="true"></i>
                            {{ user.discordPseudo ?: 'Compte lié' }}
                            <span class="badge bg-success">Lié</span>
                        </div>
                        {% if user.id == app.user.id %}
                            <button class="btn btn-sm btn-primary" type="submit"
                                    form="form-discord-synchroniser">Synchroniser mes rôles Discord</button>
                            <button class="btn btn-sm btn-outline-secondary" type="submit"
                                    form="form-discord-delier">Délier mon compte Discord</button>
                        {% endif %}
                        <div class="help-block small">
                            Votre compte Discord est vérifié. Il sert à vous attribuer vos rôles sur les serveurs Discord.
                        </div>
                    {% else %}
                        <input class="form-control" name="discord_pseudo" type="text" id="input-discord-pseudo"
                               placeholder="mon_id_discord" maxlength="33" value="{{ user.discordPseudo }}">
                        {% if user.id == app.user.id %}
                            <a class="btn btn-sm btn-primary mt-1" href="{{ path('discord.lier') }}">
                                <i class="fa-brands fa-discord" aria-hidden="true"></i> Lier mon compte Discord</a>
                        {% endif %}
                        <div class="help-block small">
                            Facultatif. Votre identifiant unique Discord (sans le @). Visible des organisateurs et des membres de votre groupe pour vous ajouter ou vous
                            contacter sur Discord. Pour recevoir vos rôles automatiquement, liez votre compte avec le bouton ci-dessus.
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if user.id == app.user.id %}
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-ui-theme">Interface bêta</label>
                    <div class="col-sm-8">
                        <input type="hidden" name="ui_theme_form" value="1">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" name="ui_theme" value="beta"
                                   id="input-ui-theme"{% if user.uiBeta %} checked{% endif %}>
                            <label class="form-check-label" for="input-ui-theme">Essayer le nouveau thème</label>
                        </div>
                        <div class="help-block small">
                            Facultatif. Ne concerne que votre compte : décochez pour revenir à l'interface actuelle.
                            Le thème est en cours de test, des pages peuvent encore être inchangées.
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if user.hasRealUsername %}
                <div class="form-group">
                    <label class="col-sm-2 control-label" for="input-name">Username</label>
                    <div class="col-sm-8">
                        <input class="form-control" name="username" type="text" id="input-username"
                               placeholder="Username" value="{{ user.realUsername }}">
                    </div>
                </div>
            {% endif %}

            <div class="form-group">
                <label class="col-sm-2 control-label">Mot de passe</label>
                <div class="col-sm-8">
                    <a class="btn btn-secondary" href="{{ path('user.password', {'user': user.id}) }}"><span
                            class="fa fa-key" style="margin-right: 5px;"></span>Changer le mot de passe</a>
                </div>
            </div>

            {% if is_granted('ROLE_ADMIN', app.user) %}
                <div class="card border-danger my-2" data-role="admin">

                    <div class="form-group">
                        <div class="card-header border-danger">
                            <h5><label class="col-sm-2 control-label" for="input-roles">
                                    <i class="fa-solid fa-user-astronaut text-danger"
                                       data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Admin"></i> Roles
                                </label></h5>
                        </div>
                        <div class="card-body">
                            {% for role, label in available_roles %}
                                <label class="control-label">
                                    <input name="roles[]" type="checkbox" value="{{ role }}"
                                           {% if user.hasRole(role) %}checked{% endif %}> {{ role }}&nbsp;- {{ label }}
                                </label><br/>
                            {% endfor %}
                            {% for role, label in reserved_roles|default({}) %}
                                <label class="control-label text-body-secondary">
                                    <input type="checkbox" checked disabled> {{ role }}&nbsp;- {{ label }}
                                    <small>(réservé au super admin, conservé)</small>
                                </label><br/>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="form-group">
                <div class="col-sm-8 col-sm-offset-2">
                    <button type="submit" class="btn btn-primary">Sauvegarder</button>
                    <a style="margin-left: 10px;" href="{{ path('user.view', {'user': user.id}) }}">Retourner au
                        profil</a>
                </div>
            </div>
        </form>

        {% if user.discordLinked and user.id == app.user.id %}
            <form id="form-discord-synchroniser" method="POST" action="{{ path('discord.synchroniser') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('discord_synchroniser') }}">
                <input type="hidden" name="retour" value="{{ path('user.edit', {'user': user.id}) }}">
            </form>
            <form id="form-discord-delier" method="POST" action="{{ path('discord.delier') }}"
                  onsubmit="return confirm('Délier votre compte Discord ? Vos rôles ne seront plus synchronisés.');">
                <input type="hidden" name="_token" value="{{ csrf_token('discord_delier') }}">
            </form>
        {% endif %}
    </div>
{% endblock %}

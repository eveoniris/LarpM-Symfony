{% extends "base.html.twig" %}

{% block title %}Compétences{% endblock title %}

{% block body %}

{% include '_partials/breadcrumb.twig' with {'items' : [{'name' : 'Liste des compétences', 'route': path('competence.list')}, {'name' : 'Matériel des compétences'}]} %}

<div class="well well-sm">
	<div class="header">
		<h5>Matériel des compétences</h5>
	</div>
	<div class="btn-toolbar" role="toolbar">
		<div class="btn-group" role="group">
			<a class="btn btn-secondary" href="{{ path('competence.list') }}"><i class="fa fa-list"></i> Retour à la liste des compétences</a>
		</div>
	</div>
</div>

<div class="table-responsive">
<table class="table table-striped table-bordered table-sm">
<thead>
	<tr>
		<th>Compétence</th>
		<th>Niveau</th>
		<th>Description</th>
		<th>matériel</th>
		<th>PDF</th>
	</tr>
</thead>
<tbody>
{%  for competence in competences %}
	<tr>
		<td>{{ competence.competenceFamily.label }}</td>
		<td>{{ competence.level.label }}</td>
		<td>{{ competence.description|markdown_to_html }}</td>
		<td>{{ competence.materiel|markdown_to_html }}</td>
		<td>
			{% if competence.documentUrl %}
				<a href="{{ path('competence.document',{'competence' : competence.id, 'document':competence.documentUrl}) }}">Téléchargez le document</a>
			{% endif %}
		</td>
	</tr>

{%  endfor %}
</tbody>
</table>
</div>
	
{% endblock body %}

{% extends "base.html.twig" %}

{% block title %}Places du groupe{% endblock %}

{% block body %}

	<ol class="breadcrumb">
		<li><a href="{{ path('homepage') }}">Accueil</a></li>
		<li><a href="{{ path("groupe.list") }}">Liste des groupes</a></li>
		<li><a href="{{ path('groupe.detail', {'groupe': groupe.id}) }}">{{ groupe.numero|default('?') }} - {{ groupe.nom }}</a></li>
		<li class="active">Places</li>
	</ol>

	<div class="well bs-component">
		{{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}
		<fieldset>
			<legend>Places du groupe {{ groupe.numero|default('?') }} - {{ groupe.nom }}</legend>

			<p>
				Utile pour les groupes de PNJ ou les groupes spéciaux. Pour un groupe classique, ne rien saisir : le nombre
				de places suit automatiquement le GN et les fiefs contrôlés.
			</p>

			{{ form_row(form.placesMax) }}
			{{ form_row(form.save) }}
		</fieldset>
		{{ form_end(form) }}
	</div>

{% endblock body %}

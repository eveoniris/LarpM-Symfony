{% extends "base.html.twig" %}

{% block title %}Autres mondes{% endblock title %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : 'Liste des autres mondes' },
        ]
    } %}

    <div class="well well-sm">

        <div class="header">
            <h5>Liste des autres mondes</h5>
        </div>

        {% include '_partials/formListSearch.twig' with
            {
                'canAdd': {'title': 'Ajouter un autre monde', 'path': path('autreMonde.add')},
                'actionPath' : path('autreMonde.list')
            } %}
    </div>

    {% include '_partials/pagination.html.twig' %}

    <div class="table-responsive">
    <table class="table table-sm table-striped table-bordered table-hover">
        {% include '_partials/thead.twig' with  { 'route': 'autreMonde.list', 'rows': [
            {'name' : 'Id', 'field' : 'id', 'css' : 'text-center'},
            {'name' : 'Titre', 'field' : 'titre', 'css' : 'text-center'},
            {'name' : 'Description', 'field' : 'description'},
            {'name' : 'Actions', 'css' : 'text-center'},
        ]} %}
        <tbody>
        {% for autreMonde in paginator %}
            <tr>
                <td class="text-center align-middle col-1">
                    {{ autreMonde.id|highlight(pagerService.searchValue) }}
                </td>
                <td class="text-center align-middle col-1">{{ autreMonde.titre|highlight(pagerService.searchValue) }}</td>
                <td>
                    {{ autreMonde.description|markdown_to_html|highlight(pagerService.searchValue) }}
                </td>
                <td class="col-1">
                    <div class="btn-toolbar float-end" role="toolbar">
                        <div class="btn-group-vertical" role="group">
                            <a class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="bottom"
                               title="Modifier"
                               href="{{ path('autreMonde.update',{'autreMonde':autreMonde.id}) }}"><i
                                        class="fa fa-pencil"></i> Modifier</a>
                            <a class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="bottom"
                               title="Détail"
                               href="{{ path('autreMonde.detail',{'autreMonde':autreMonde.id}) }}"><i
                                        class="fa fa-eye"></i> Detail</a>
                            <a class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="bottom"
                               title="Supprimer"
                               href="{{ path('autreMonde.delete',{'autreMonde':autreMonde.id}) }}"><i
                                        class="fa fa-eraser"></i> Supprimer</a>
                        </div>
                    </div>
                </td>
            </tr>
        {% else %}
            {% include '_partials/noResultTableRow.twig' %}
        {% endfor %}
        </tbody>
    </table>
    </div>

    {% include '_partials/pagination.html.twig' %}


{% endblock %}

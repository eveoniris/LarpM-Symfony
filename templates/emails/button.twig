{# For base.email.html.twig : bouton lm-design pour les comptes bêta (uiBeta), ancien bouton sinon #}
{% if uiBeta|default(false) %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 4px;">
    <tr>
        <td class="btn" align="center" bgcolor="#d98a3d" style="background:#d98a3d;border-radius:6px;">
            <a href="{{ linkHref }}" target="_blank" style="display:inline-block;padding:13px 26px;font-family:'Source Sans 3','Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;font-weight:700;color:#1a1208;text-decoration:none;">{{ linkText }}</a>
        </td>
    </tr>
</table>
{% else %}
<div class="table-responsive">
<table style="margin-top:1em;">
<tr>
    <td align="center" valign="top">
        <div class="table-responsive">
        <table border="0" cellpadding="0" cellspacing="0" width="100%">
            <tr style="padding-top:0;">
                <td align="center" valign="top">
                    <div class="table-responsive">
                    <table border="0" cellpadding="30" cellspacing="0" width="500" class="flexibleContainer">
                        <tr>
                            <td align="center" valign="top" width="500" class="flexibleContainerCell">
                                <div class="table-responsive">
                                <table border="0" cellpadding="0" cellspacing="0" width="50%" class="emailButton">
                                    <tr>
                                        <td align="center" valign="middle" class="buttonContent" style="padding:15px;">
                                            <a class="btn btn-secondary emailButton" href="{{ linkHref }}" target="_blank">{{ linkText }}</a>
                                        </td>
                                    </tr>
                                </table>
                                </div>

                            </td>
                        </tr>
                    </table>
                    </div>
                </td>
            </tr>
        </table>
        </div>
    </td>
</tr>
</table>
</div>
{% endif %}

{% extends "base.html.twig" %}

{% block title %}Demander une application API{% endblock title %}

{% block body %}

    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        <li class="active">Demande d'application API</li>
    </ol>

    {% for error in errors %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endfor %}

    <div class="well bs-component">
        <h3>Demander une application API</h3>
        <p class="text-muted small">
            Une application tierce (outil de comptoir, application mobile...) peut lire certaines données d'un GN.
            Votre demande est examinée par un administrateur, qui vous transmettra les identifiants si elle est acceptée.
            Seul l'accès en lecture seule est proposé.
        </p>
        <form method="POST" action="{{ path('api.client.request') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('api_client_request') }}">

            <div class="mb-3">
                <label class="form-label" for="name">Nom de l'application</label>
                <input class="form-control" id="name" name="name" maxlength="60" required value="{{ form.name }}">
                <div class="form-text">Lettres, chiffres, tiret et underscore.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="purpose">Usage prévu</label>
                <textarea class="form-control" id="purpose" name="purpose" rows="5" maxlength="2000" required>{{ form.purpose }}</textarea>
                <div class="form-text">Quelles données voulez-vous lire, et pour quoi faire ?</div>
            </div>

            <div class="mb-3">
                <label class="form-label" for="gn">GN concerné</label>
                <select class="form-select" id="gn" name="gn">
                    <option value="">GN actif par défaut</option>
                    {% for gn in gns %}
                        <option value="{{ gn.id }}" {{ form.gn == (gn.id ~ '') ? 'selected' }}>{{ gn.label }}</option>
                    {% endfor %}
                </select>
            </div>

            <button class="btn btn-primary" type="submit">Envoyer la demande</button>
        </form>
    </div>

    {% if mine is not empty %}
        <div class="well bs-component">
            <h3>Mes demandes</h3>
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead><tr><th>Date</th><th>Application</th><th>État</th><th>Motif</th></tr></thead>
                    <tbody>
                    {% for demande in mine %}
                        <tr>
                            <td>{{ demande.createdAt|date('d/m/Y') }}</td>
                            <td>{{ demande.name }}</td>
                            <td>
                                {% if demande.status == 'en_attente' %}En attente
                                {% elseif demande.status == 'acceptee' %}Acceptée
                                {% else %}Refusée{% endif %}
                            </td>
                            <td>{{ demande.decisionNote }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

{% endblock body %}

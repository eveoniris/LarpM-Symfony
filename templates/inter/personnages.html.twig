{% extends "base.html.twig" %}

{% block title %}Participants - {{ interJeu.nom }}{% endblock title %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items': [
        {'name': 'Liste des inter-jeux', 'route': path('inter.list')},
        {'name': interJeu.nom, 'route': path('inter.detail', {'inter': interJeu.id})},
        {'name': 'Participants'}
    ]} %}

    <div class="well well-sm">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5>Participants à {{ interJeu.nom }} <small>({{ interJeu.participations|length }})</small></h5>
            <div class="btn-group flex-wrap" role="group">
                <a class="btn btn-sm btn-secondary" href="{{ path('inter.personnage.add', {'inter': interJeu.id}) }}">
                    <i class="fa fa-user-plus"></i> Ajouter un participant
                </a>
                <a class="btn btn-sm btn-secondary" href="{{ path('inter.personnages.import', {'inter': interJeu.id}) }}">
                    <i class="fa fa-users"></i> Importer plusieurs
                </a>
                <a class="btn btn-sm btn-secondary" href="{{ path('inter.statistiques', {'inter': interJeu.id}) }}">
                    <i class="fa fa-chart-bar"></i> Statistiques
                </a>
                <a class="btn btn-sm btn-secondary" target="_blank"
                   href="{{ path('inter.personnages.print.materiel', {'inter': interJeu.id}) }}">
                    <i class="fa fa-print"></i> Imprimer matériel
                </a>
                <a class="btn btn-sm btn-secondary" target="_blank"
                   href="{{ path('inter.personnages.print.fiche', {'inter': interJeu.id}) }}">
                    <i class="fa fa-print"></i> Imprimer fiches
                </a>
            </div>
        </div>
        <div class="mt-2">
            {% for statut in statuts %}
                <span class="badge {{ statut.badgeClass }}">{{ statut.label }} : {{ interJeu.countByStatut(statut) }}</span>
            {% endfor %}
            <small class="text-muted ms-1">Seuls les inscrits comptent dans les statistiques, les impressions et la chronologie.</small>
        </div>
    </div>

    {% if interJeu.countPropositions > 0 %}
        <div class="alert alert-warning">
            <i class="fa fa-hourglass-half"></i>
            {{ interJeu.countPropositions }} proposition(s) d'orga externe à valider ou refuser (colonne « Proposition »).
        </div>
    {% endif %}

    <div class="table-responsive">
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                <th class="text-center">#</th>
                <th>Nom</th>
                <th>Statut</th>
                <th>Proposition</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for participation in interJeu.participations %}
            {% set personnage = participation.personnage %}
            <tr>
                <td class="text-center">{{ personnage.id }}</td>
                <td>
                    <a href="{{ path('personnage.detail', {'personnage': personnage.id}) }}">
                        {{ personnage.nom }}
                    </a>
                </td>
                <td>
                    <form method="post" class="d-flex gap-1 align-items-center"
                          action="{{ path('inter.personnage.statut', {'inter': interJeu.id, 'personnage': personnage.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('statut_personnage_' ~ personnage.id) }}">
                        <select name="statut" class="form-select form-select-sm w-auto" aria-label="Statut de {{ personnage.nom }}">
                            {% for statut in statuts %}
                                <option value="{{ statut.value }}" {{ statut == participation.statut ? 'selected' }}>{{ statut.label }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Enregistrer</button>
                    </form>
                </td>
                <td>
                    {% if participation.hasProposition %}
                        <form method="post" class="d-flex gap-1 align-items-center flex-wrap"
                              action="{{ path('inter.personnage.proposition', {'inter': interJeu.id, 'personnage': personnage.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('proposition_' ~ personnage.id) }}">
                            <span class="badge {{ participation.statutPropose.badgeClass }}">{{ participation.statutPropose.label }}</span>
                            {% if participation.proposePar %}
                                <small class="text-muted">par {{ participation.proposePar.username }}</small>
                            {% endif %}
                            <button type="submit" name="decision" value="valider" class="btn btn-sm btn-success">Valider</button>
                            <button type="submit" name="decision" value="refuser" class="btn btn-sm btn-outline-danger">Refuser</button>
                        </form>
                    {% else %}
                        <span class="text-muted">-</span>
                    {% endif %}
                </td>
                <td class="text-center">
                    <form method="post"
                          action="{{ path('inter.personnage.remove', {'inter': interJeu.id, 'personnage': personnage.id}) }}"
                          onsubmit="return confirm('Retirer {{ personnage.nom|e('js') }} de l\'inter-jeu ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('remove_personnage_' ~ personnage.id) }}">
                        <button type="submit" class="btn btn-sm btn-danger"
                                data-bs-toggle="tooltip" data-bs-placement="bottom" title="Retirer de la liste">
                            <i class="fa fa-minus-circle"></i> Retirer
                        </button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5" class="text-center">Aucun participant.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

{% endblock body %}

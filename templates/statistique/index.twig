{% extends "base.html.twig" %}

{% block title %}Statistique{% if gn %} - {{ gn.label }}{% endif %}{% endblock title %}

{# Chart.js est servi par l'importmap (assets/vendor) : aucun CDN. #}
{% block importmap %}{{ importmap(['app', 'stats']) }}{% endblock %}

{% block body %}

	<ol class="breadcrumb">
		<li><a href="{{ path('homepage') }}">Accueil</a></li>
		<li class="active">Statistique{% if gn %} - {{ gn.label }}{% endif %}</li>
	</ol>

	{% if allGns|length > 0 %}
	<div class="well well-sm">
		<form action="{{ path('statistique') }}" method="get" class="form-inline">
			<div class="form-group">
				<label for="gn-selector"><strong>Sélectionner un GN :</strong></label>
				<select id="gn-selector" name="gn" class="form-control" onchange="this.form.submit()">
					{% for allGn in allGns %}
						<option value="{{ allGn.id }}"{% if gn and gn.id == allGn.id %} selected{% endif %}>
							{{ allGn.label }}
						</option>
					{% endfor %}
				</select>
			</div>
			<noscript><button type="submit" class="btn btn-primary">Afficher</button></noscript>
		</form>
	</div>
	{% endif %}

	{% if not gn %}
		<div class="alert alert-info">Aucun GN actif : il n'y a pas de statistiques à afficher.</div>
	{% else %}

	<div class="panel panel-default">
		<div class="panel-body">
			<div class="table-responsive">
			<table class="table">
				<thead>
					<tr>
						<th>Joueurs inscrits</th>
						<th>Personnages créés</th>
						<th>État civil rempli</th>
						<th>Places des groupes PJ</th>
						<th>Places prises</th>
						<th>Places libres</th>
						<th>Sans groupe</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>{{ kpis.joueurs }}</td>
						<td>{{ kpis.personnages }}</td>
						<td>{{ kpis.etatCivil }}</td>
						<td>{{ kpis.placesTotal }}</td>
						<td>{{ kpis.placesPrises }}</td>
						<td>{{ kpis.placesLibres }}</td>
						<td>{{ kpis.sansGroupe }}</td>
					</tr>
				</tbody>
			</table>
			</div>
			<p class="text-muted small">
				Les aides de camp ne sont pas comptées. Les places d'un groupe sont celles du GN ({{ gn.placesParGroupe }} par défaut,
				+2 par fief au-delà du premier) ou la valeur fixée à la main sur le groupe.
			</p>

			{% if kpis.placesTotal > 0 %}
			<h4>Personnages créés / places ({{ kpis.personnages }} / {{ kpis.placesTotal }})</h4>
			<div class="progress">
				<div class="progress-bar" role="progressbar" aria-valuenow="{{ kpis.tauxPersonnages }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ kpis.tauxPersonnages }}%;">
					{{ kpis.tauxPersonnages|number_format(1, ',') }} %
				</div>
			</div>
			{% endif %}

			{% if kpis.joueurs > 0 %}
			<h4>État civil rempli / joueurs inscrits ({{ kpis.etatCivil }} / {{ kpis.joueurs }})</h4>
			<div class="progress">
				<div class="progress-bar" role="progressbar" aria-valuenow="{{ kpis.tauxEtatCivil }}" aria-valuemin="0" aria-valuemax="100" style="width: {{ kpis.tauxEtatCivil }}%;">
					{{ kpis.tauxEtatCivil|number_format(1, ',') }} %
				</div>
			</div>
			{% endif %}
		</div>
	</div>

	<div class="row">
		{% set cadres = {
			'langues': 'Répartition des territoires par langues',
			'classes': 'Répartition des personnages par classe',
			'genres': 'Répartition des personnages par genre',
			'competencesFamily': 'Répartition des compétences par famille',
			'competences': 'Répartition des compétences par famille et par niveau',
			'constructions': 'Répartition des constructions par territoires',
		} %}
		{% for id, titre in cadres %}
			<div class="col-sm-4">
				<div class="panel panel-default">
					<div class="panel-heading">{{ titre }}</div>
					<div class="panel-body">
						<canvas id="chart-{{ id }}"></canvas>
					</div>
				</div>
			</div>
		{% endfor %}
	</div>

	{% endif %}

{% endblock %}

{% block javascripts %}
	{{ parent() }}

	{% if gn %}
	<script type="module">
		// Chart est exposé par assets/stats.js (importmap), indépendamment du chargement de 'app'
		import 'stats';

		const Chart = window.Chart;

		// Palette fixe : couleurs stables d'un affichage à l'autre.
		const palette = ['#2e86ab', '#e4572e', '#76b041', '#f3a712', '#a23b72', '#17bebb', '#6c757d', '#8d6a9f', '#c1666b', '#4b7f52'];

		const charts = {{ repartitions|json_encode|raw }};

		Object.entries(charts).forEach(([id, rows]) => {
			const canvas = document.getElementById('chart-' + id);
			if (!canvas) {
				return;
			}

			if (!rows.length) {
				canvas.replaceWith(Object.assign(document.createElement('p'), {
					className: 'text-muted mb-0',
					textContent: 'Aucune donnée pour ce GN.'
				}));
				return;
			}

			new Chart(canvas, {
				type: 'pie',
				data: {
					labels: rows.map((row) => row.label),
					datasets: [{
						data: rows.map((row) => row.value),
						backgroundColor: rows.map((row, index) => palette[index % palette.length])
					}]
				},
				options: {responsive: true, plugins: {legend: {position: 'bottom'}}}
			});
		});
	</script>
	{% endif %}
{% endblock %}

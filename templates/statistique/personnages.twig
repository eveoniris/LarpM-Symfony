{% extends "base.html.twig" %}

{% block title %}Extract des personnages{% if selectedGn %} - {{ selectedGn.label }}{% endif %}{% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.css"/>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/dataTables.buttons.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/buttons.dataTables.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/3.2.3/js/buttons.print.min.js"></script>

    <script type="application/javascript">
        jQuery(document).ready(function () {
            new DataTable('#stats-table', {
                'pageLength': 100,
                'scrollX': true,
                'layout': {
                    'topStart': {
                        'buttons': ['copy', 'csv', 'excel', 'pdf', 'print']
                    }
                }
            });
        });
    </script>
{% endblock %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : 'Statistiques', 'route': path('stats.list') },
            {'name' : 'Extract des personnages' },
        ]
    } %}

    <div class="d-flex justify-content-end">

        <div class="btn-toolbar" role="toolbar" aria-label="...">
            <div class="btn-group" role="group" aria-label="...">
                <a class="btn btn-secondary" data-toggle="tooltip" data-placement="bottom"
                   title="Télécharger" href="{{ path('stats.personnages.csv', selectedGn ? {'gn': selectedGn.id} : {}) }}"><i
                            class="fa fa-file-csv"></i>
                    Télécharger</a>
                <a class="btn btn-secondary" data-toggle="tooltip" data-placement="bottom"
                   title="format JSON" href="{{ path('stats.personnages.json', selectedGn ? {'gn': selectedGn.id} : {}) }}"><i
                            class="fa fa-file-lines"></i>
                    Json API</a>
            </div>
        </div>
    </div>

    <div class="well well-sm">
        <div class="header">
            <h5>
                Extract des personnages
                {% if selectedGn %} ayant participé à {{ selectedGn.label }}{% else %} (tous GN){% endif %}
            </h5>
        </div>

        <div class="row mb-3">
            <div class="col-md-5">
                <form action="{{ path('stats.personnages') }}" method="get" class="form-inline">
                    <div class="form-group">
                        <label for="gn-selector"><strong>Filtrer sur un GN :</strong></label>
                        <select id="gn-selector" name="gn" class="form-control">
                            <option value=""{% if not selectedGn %} selected{% endif %}>Tous les GN</option>
                            {% for allGn in allGns %}
                                <option value="{{ allGn.id }}"{% if selectedGn and selectedGn.id == allGn.id %} selected{% endif %}>
                                    {{ allGn.label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Afficher</button>
                </form>
            </div>
        </div>

        <p class="text-muted">
            Une colonne par famille de compétences : il s'agit du meilleur niveau atteint dans la famille,
            <code>0</code> si le personnage n'en possède aucune.
        </p>

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm table-hover" id="stats-table">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Classe</th>
                    <th>Age</th>
                    <th>Age réel</th>
                    <th>Genre</th>
                    <th>Origine</th>
                    <th class="text-center">Renommée</th>
                    <th class="text-center">Vivant</th>
                    <th class="text-center">PNJ</th>
                    <th class="text-center">XP total</th>
                    <th class="text-center">Persos morts du joueur</th>
                    <th>Joueur</th>
                    {% for famille in familles %}
                        <th class="text-center" title="Famille de compétences : {{ famille.label }}">{{ famille.label }}</th>
                    {% endfor %}
                </tr>
                </thead>
                <tbody>
                {% for personnage in personnages %}
                    <tr>
                        <td>{{ personnage.personnageId }}</td>
                        <td>
                            <a href="{{ path('personnage.detail', {'personnage': personnage.personnageId}) }}">
                                {{ personnage.nom }}
                            </a>
                        </td>
                        <td>{{ personnage.classe }}</td>
                        <td>{{ personnage.age }}</td>
                        <td>{{ personnage.ageReel }}</td>
                        <td>{{ personnage.genre }}</td>
                        <td>{{ personnage.origine }}</td>
                        <td class="text-center">{{ personnage.renomme }}</td>
                        <td class="text-center">{{ personnage.vivant ? 'oui' : 'non' }}</td>
                        <td class="text-center">{{ personnage.pnj ? 'oui' : 'non' }}</td>
                        <td class="text-center">{{ personnage.xpTotal }}</td>
                        <td class="text-center">{{ personnage.nbPersosMortsJoueur }}</td>
                        <td>
                            {% if personnage.userId %}
                                <a href="{{ path('user.detail', {'user': personnage.userId}) }}">{{ personnage.email }}</a>
                            {% endif %}
                        </td>
                        {% for famille in familles %}
                            <td class="text-center">{{ attribute(personnage, 'fam_' ~ famille.id)|default(0) }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

    </div>

{% endblock %}
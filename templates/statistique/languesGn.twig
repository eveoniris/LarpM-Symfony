{% extends "base.html.twig" %}

{% block title %}Langues par GN{% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.css"/>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.js"></script>

    <script type="application/javascript">
        jQuery(document).ready(function () {
            new DataTable('#stats-table', {
                'pageLength': 100,
                'order': [[0, 'desc']]
            });
        });
    </script>
{% endblock %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : 'Statistiques', 'route': path('stats.list') },
            {'name' : 'Répartition des joueurs par langue ' ~ gn.label },
        ]
    } %}

    <div class="d-flex justify-content-end">
        <div class="btn-toolbar" role="toolbar" aria-label="...">
            <div class="btn-group" role="group" aria-label="...">
                <a class="btn btn-secondary" title="Télécharger"
                   href="{{ path('stats.langues.gn.csv', {'gn':gn.id}) }}"><i class="fa fa-file-csv"></i>
                    Télécharger</a>
                <a class="btn btn-secondary" title="format JSON"
                   href="{{ path('stats.langues.gn.json', {'gn':gn.id}) }}"><i class="fa fa-file-lines"></i>
                    Json API</a>
            </div>
        </div>
    </div>

    <div class="well well-sm">
        <div class="header">
            <h5>Répartition des joueurs par langue {{ gn.label }}</h5>
        </div>

        {% include '_partials/cardNotif.twig' with {'type' : 'info', 'content' : "Nombre de personnages vivants inscrits au GN qui parlent chaque langue (langues de bonus comprises)"} %}

        <div class="table-responsive">
            <table class="table table-striped table-bordered table-sm table-hover" id="stats-table">
                {% include '_partials/thead.twig' with  { 'route': 'stats.list', 'rows': [
                    {'name' : 'Total', 'css': 'text-center'},
                    {'name' : 'Langue'},
                    {'name' : 'Visibilité'},
                ]} %}
                <tbody>
                {% for langue in langues %}
                    <tr>
                        <td class="text-center col-1">
                            {% if langue.id %}
                                <a href="{{ path('langue.personnages.gn', {'langue': langue.id, 'gn': gn.id}) }}">{{ langue.total }}</a>
                            {% else %}
                                {{ langue.total }}
                            {% endif %}
                        </td>
                        <td class="col-8">{{ langue.langue }}</td>
                        <td class="col-3">{{ langue.secret ? 'Secrète' : 'Visible' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

{% endblock %}

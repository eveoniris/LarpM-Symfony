{% extends "base.html.twig" %}

{% block title %}Étapes de {{ gn.label }}{% endblock title %}

{% block body %}
    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        <li><a href="{{ path('gn.detail', {'gn': gn.id}) }}">{{ gn.label }}</a></li>
        <li class="active">Étapes de la chronologie</li>
    </ol>

    <div class="well bs-component">
        <div class="header"><h5>Étapes de la chronologie : {{ gn.label }}</h5></div>

        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                <tr><th>Date</th><th>Libellé</th><th>Visibilité</th><th></th></tr>
                </thead>
                <tbody>
                {% for etape in etapes %}
                    <tr>
                        <td>{{ etape.datePrevue|date('d/m/Y H:i') }}</td>
                        <td>{{ etape.libelle }}</td>
                        <td><span class="lm-badge" data-role="{{ etape.visibilite.value == 'public' ? 'ok' : (etape.visibilite.value == 'secret' ? 'warn' : 'err') }}">{{ etape.visibilite.label }}</span></td>
                        <td class="text-end">
                            <a class="btn btn-secondary btn-sm" href="{{ path('gn.etape.update', {'etape': etape.id}) }}"><i class="fa fa-pencil"></i></a>
                            <form class="d-inline" method="post" action="{{ path('gn.etape.delete', {'etape': etape.id}) }}"
                                  onsubmit="return confirm('Supprimer cette étape ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('gn_etape_delete_' ~ etape.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit"><i class="fa fa-eraser"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="text-body-secondary">Aucune étape pour ce GN.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="well bs-component">
        <div class="header"><h5>Ajouter une étape</h5></div>
        {{ form(form) }}
    </div>
{% endblock body %}

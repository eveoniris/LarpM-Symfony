{% extends "base.html.twig" %}

{% block title %}Étapes de {{ gn.label }}{% endblock title %}

{% block body %}
    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        <li><a href="{{ path('gn.detail', {'gn': gn.id}) }}">{{ gn.label }}</a></li>
        <li class="active">Étapes de la chronologie</li>
    </ol>

    <div class="well bs-component">
        <div class="header"><h5>Étapes de la chronologie : {{ gn.label }}</h5></div>

        <div class="table-responsive">
            <table class="table table-striped table-sm">
                <thead>
                <tr><th>Date</th><th>Libellé</th><th>Type</th><th>Statut</th><th>Visibilité</th><th></th></tr>
                </thead>
                <tbody>
                {% for etape in etapes %}
                    <tr>
                        <td>
                            {% if etape.dateEffective %}{{ etape.dateEffective|date('d/m/Y H:i') }}{% else %}<span class="text-body-secondary">Date de verrouillage du GN non définie : étape manuelle</span>{% endif %}
                            {% if etape.type.value == 'verrouillage' %}<small class="d-block text-body-secondary">Date du GN</small>{% endif %}
                        </td>
                        <td>{{ etape.libelle }}</td>
                        <td>
                            {{ etape.type.label }}{% if etape.type.value == 'xp_participation' and etape.xp %} ({{ etape.xp }} XP){% endif %}{% if etape.type.value == 'vieillissement' %} (+{{ etape.annees ?? 5 }} ans, mort dès {{ etape.ageMort ?? 60 }} ans){% endif %}
                            {% if etape.auto %}<span class="lm-badge" data-role="warn" title="Exécutée par le cron quand la date est passée">auto</span>{% endif %}
                        </td>
                        <td>
                            {% if etape.type.value != 'info' %}
                                <span class="lm-badge" data-role="{{ etape.statut.value == 'execute' ? 'ok' : (etape.statut.value == 'erreur' ? 'err' : 'warn') }}"
                                      {% if etape.resultat %}title="{{ etape.resultat }}"{% endif %}>{{ etape.statut.label }}</span>
                                {% if etape.executedAt %}<small class="d-block text-body-secondary">{{ etape.executedAt|date('d/m/Y H:i') }}</small>{% endif %}
                            {% endif %}
                        </td>
                        <td><span class="lm-badge" data-role="{{ etape.visibilite.value == 'public' ? 'ok' : (etape.visibilite.value == 'secret' ? 'warn' : 'err') }}">{{ etape.visibilite.label }}</span></td>
                        <td class="text-end">
                            {% if etape.type.value != 'info' and etape.statut.value in ['a_faire', 'erreur'] %}
                                <form class="d-inline" method="post" action="{{ path('gn.etape.execute', {'etape': etape.id}) }}"
                                      onsubmit="return confirm('Exécuter maintenant : {{ etape.type.label|e('js') }} ? Cette action modifie les données du jeu.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('gn_etape_execute_' ~ etape.id) }}">
                                    <button class="btn btn-warning btn-sm" type="submit" title="Exécuter maintenant"><i class="fa fa-play"></i></button>
                                </form>
                            {% endif %}
                            <a class="btn btn-secondary btn-sm" href="{{ path('gn.etape.update', {'etape': etape.id}) }}"><i class="fa fa-pencil"></i></a>
                            <form class="d-inline" method="post" action="{{ path('gn.etape.delete', {'etape': etape.id}) }}"
                                  onsubmit="return confirm('Supprimer cette étape ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('gn_etape_delete_' ~ etape.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit"><i class="fa fa-eraser"></i></button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="text-body-secondary">Aucune étape pour ce GN.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="well bs-component">
        <div class="header"><h5>Ajouter une étape</h5></div>
        {{ form(form) }}
    </div>
{% endblock body %}

{% import 'groupeSecondaire/fragment/_ui.twig' as ui %}
{% import 'groupeSecondaire/fragment/_more.twig' as more %}
{% set beta = app.user is not null and app.user.uiBeta %}

{# File de décisions. Le chef et les membres ayant accès au secret voient les postulants (pseudos uniquement). #}
<div class="{{ beta ? 'lm-card' : 'card' }}">
    <div class="{{ beta ? 'lm-card-head' : 'card-header' }}">
        <h4 class="{{ beta ? 'lm-card-title' : 'h6 mb-0' }}">Postulants <span class="{{ beta ? 'lm-count' : 'badge text-bg-secondary' }}">{{ postulants|length }}</span></h4>
    </div>

    {% set paged = beta and postulants|length > 25 %}
    {% if paged %}<div data-lm-more="25">{{ more.start('Rechercher un postulant') }}{% endif %}
    {% for postulant in postulants %}
        {% if paged %}<div class="lm-more-row" data-lm-row>{% endif %}
        {% include 'groupeSecondaire/fragment/postulant.twig' %}
        {% if paged %}</div>{% endif %}
    {% else %}
        {% include '_partials/noResult.twig' with {'content': 'Aucune candidature en attente'} %}
    {% endfor %}
    {% if paged %}{{ more.end() }}</div>{% endif %}
</div>

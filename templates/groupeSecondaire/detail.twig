{% extends "base.html.twig" %}
{% import 'groupeSecondaire/fragment/_ui.twig' as ui %}

{% block title %}{{ groupeSecondaire.label }}{% endblock title %}

{% block body %}
    {% set beta = app.user is not null and app.user.uiBeta %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : 'Liste des groupes transverses', 'route': path('groupeSecondaire.list') },
            {'name' : "Détail de #{groupeSecondaire.label}" },
        ]
    } %}

    {# En-tête : titre, type, nombre de membres, action principale #}
    <div class="{{ beta ? 'lm-page-head' : 'd-flex flex-wrap justify-content-between align-items-start gap-2' }} mb-3">
        <div>
            <h3 class="{{ beta ? 'lm-page-title' : 'mb-1' }}">
                {% if groupeSecondaire.secret %}
                    <i class="fa fa-user-secret text-warning" title="Secret" data-bs-toggle="tooltip"></i>
                {% endif %}
                {{ groupeSecondaire.label }}
            </h3>
            <div class="{{ beta ? 'lm-meta' : 'd-flex flex-wrap gap-3 text-body-secondary small' }}">
                {% if groupeSecondaire.secondaryGroupType %}
                    {% set typeIcons = {'confrérie': 'fa-book-open', 'guilde': 'fa-hammer', 'religion': 'fa-hands-praying', 'groupe': 'fa-users'} %}
                    <span>{{ ui.badge(groupeSecondaire.secondaryGroupType.label, 'muted', beta, typeIcons[groupeSecondaire.secondaryGroupType.label|lower]|default('fa-users')) }}</span>
                {% endif %}
                {% if groupeSecondaire.discord and groupeSecondaire.showDiscord and canRead %}
                    <span><i class="fa-brands fa-discord" aria-hidden="true"></i> Discord</span>
                {% endif %}
            </div>
        </div>

        <div class="{{ beta ? 'lm-actions' : 'd-flex flex-wrap gap-2 align-items-center' }}">
            {% if canPostuler|default(false) %}
                <a class="{{ ui.btn('primary', beta) }}"
                   href="{{ path('groupeSecondaire.postuler', {'groupeSecondaire': groupeSecondaire.id}) }}">Postuler</a>
            {% elseif canContacterChef|default(false) %}
                <a class="{{ ui.btn('primary', beta) }}"
                   href="{{ path('groupeSecondaire.contact', {'groupeSecondaire': groupeSecondaire.id}) }}">Contacter le chef</a>
            {% endif %}

            {% if canManage or isAdmin %}
                <div class="dropdown">
                    <button class="{{ ui.more_button(beta) }}" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Plus d'actions"><i class="fa fa-ellipsis" aria-hidden="true"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% if canManage %}
                            <li><a class="dropdown-item" href="{{ path('groupeSecondaire.update', {'groupeSecondaire': groupeSecondaire.id}) }}"><i class="fa fa-pencil" aria-hidden="true"></i> Modifier le groupe transverse</a></li>
                            <li><a class="dropdown-item" href="{{ path('groupeSecondaire.newMembre', {'groupeSecondaire': groupeSecondaire.id}) }}"><i class="fa fa-plus" aria-hidden="true"></i> Ajouter un membre</a></li>
                        {% endif %}
                        {% if isAdmin %}
                            <li><a class="dropdown-item" href="{{ path('groupeSecondaire.materiel.update', {'groupeSecondaire': groupeSecondaire.id}) }}"><i class="fa fa-box" aria-hidden="true"></i> Modifier le matériel</a></li>
                            <li><a class="dropdown-item" href="{{ path('groupeSecondaire.materiel.print', {'groupeSecondaire': groupeSecondaire.id}) }}"><i class="fa fa-print" aria-hidden="true"></i> Imprimer l'enveloppe</a></li>
                        {% endif %}
                    </ul>
                </div>
            {% endif %}
        </div>
    </div>

    {% if groupeSecondaire.secret %}
        {% include '_partials/cardNotif.twig' with {'type' : 'warning', 'content' : 'Ce groupe est secret'} %}
    {% endif %}
    {% if groupeSecondaire.private %}
        {% include '_partials/cardNotif.twig' with {'type' : 'warning', 'content' : 'Ce groupe est anonyme, seul le chef peut voir les personnages. Vous pouvez contacter le chef sans savoir qui il est'} %}
    {% endif %}

    {# Navigation mobile par offcanvas (visible uniquement sur xs/sm) #}
    {% set tabItems = [] %}
    {% for key, label in tabs %}
        {% set tabItems = tabItems|merge([{
            'path': path('groupeSecondaire.detail.tab', {'groupeSecondaire': groupeSecondaire.id, 'tab': key}),
            'label': label,
            'active': tab == key,
        }]) %}
    {% endfor %}
    {% include '_partials/offcanvasTabs.twig' with {
        'offcanvasId': 'offcanvasGroupeSecondaireTabs',
        'title': 'Navigation',
        'triggerLabel': tabs[tab]|default('Navigation'),
        'groups': [{'items': tabItems}]
    } %}

    {# Onglets desktop (cachés sur mobile) #}
    <nav class="{{ beta ? 'lm-tabs' : 'nav nav-tabs' }} d-none d-md-flex mb-3" data-turbo="false" aria-label="Groupe transverse">
        {% for key, label in tabs %}
            <a class="{{ beta ? 'lm-tab' : 'nav-link' ~ (tab == key ? ' active' : '') }}"
               {% if tab == key %}aria-current="page"{% endif %}
               {% if key == 'scenarisation' %}data-role="gm"{% endif %}
               href="{{ path('groupeSecondaire.detail.tab', {'groupeSecondaire': groupeSecondaire.id, 'tab': key}) }}">
                {% if key == 'scenarisation' %}<i class="fa fa-feather" aria-hidden="true"></i> {% endif %}{{ label }}
                {% if tabCounts[key] is defined and key in ['membres', 'postulants'] %}
                    <span class="{{ beta ? 'lm-count' : 'badge text-bg-secondary' }} ms-1">{{ tabCounts[key] }}</span>
                {% endif %}
            </a>
        {% endfor %}
    </nav>

    <div class="tab-content" data-turbo="false">
        <div role="tabpanel" class="tab-pane active">
            {% include "groupeSecondaire/tab/#{tab}.twig" %}
        </div>
    </div>
{% endblock body %}

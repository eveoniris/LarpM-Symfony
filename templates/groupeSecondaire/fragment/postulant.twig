{#
Candidature : avatar, nom, statut, message, décisions (Accepter, Rejeter, menu ⋯ avec Répondre et Mettre en attente).
Variables : postulant, et le contexte de la page.
#}
{% import 'groupeSecondaire/fragment/_ui.twig' as ui %}
{% set beta = app.user is not null and app.user.uiBeta %}
{% set personnage = postulant.personnage %}

<div class="border-bottom">
    <div class="{{ beta ? 'lm-member' : 'd-flex align-items-center gap-3 px-3 py-2' }}">
        {{ ui.avatar(personnage, beta) }}

        <div class="{{ beta ? '' : 'flex-grow-1 min-w-0' }}">
            <div>
                {% if isAdmin %}
                    <a class="link-gamemaster fw-semibold" href="{{ path('personnage.detail', {'personnage': personnage.id}) }}">
                        <i class="fa fa-feather" title="Lien scénariste" data-bs-toggle="tooltip" data-bs-placement="top"></i>
                        {{ personnage.publicName }}</a>
                {% else %}
                    <strong>{{ personnage.publicName }}</strong>
                {% endif %}
            </div>
            <div class="{{ beta ? 'lm-member-meta' : 'd-flex flex-wrap gap-2 align-items-center small text-body-secondary' }}">
                {% if postulant.waiting %}
                    {{ ui.badge('Mis en attente', 'info', beta) }}
                {% endif %}
                {% if gn %}
                    {% if inscriptions[personnage.id] is defined %}
                        <span class="text-success">Inscrit à {{ gn.label }}</span>
                    {% else %}
                        <span class="text-warning"><i class="fa fa-warning" aria-hidden="true"></i> Ne participe pas à {{ gn.label }}</span>
                    {% endif %}
                {% endif %}
                {% if postulant.date %}
                    <span>Demande du {{ postulant.date|date('d/m/Y') }}</span>
                {% endif %}
                {% if isAdmin %}
                    {% if personnage.groupe %}
                        <a class="link-gamemaster" href="{{ path('groupe.detail', {'groupe': personnage.groupe.id}) }}"><i class="fa fa-feather" aria-hidden="true"></i> {{ personnage.groupe.nom }}</a>
                    {% endif %}
                    {% if personnage.user %}
                        <a class="link-gamemaster" href="{{ path('user.view', {'user': personnage.user.id}) }}"><i class="fa fa-feather" aria-hidden="true"></i> {{ personnage.user.username }}</a>
                    {% endif %}
                {% endif %}
                {% if groupeSecondaire.isReligion %}
                    {% for personnageReligion in personnage.personnagesReligions %}
                        <span>{{ personnageReligion.religion.label }} ({{ personnageReligion.religionLevel.label }})</span>
                    {% endfor %}
                {% endif %}
            </div>
        </div>

        {% if canManage %}
            <div class="{{ beta ? 'lm-actions' : 'd-flex gap-2 align-items-center' }}">
                <a class="{{ ui.btn('primary', beta, true) }}"
                   href="{{ path('groupeSecondaire.postulant.accept', {'groupeSecondaire': groupeSecondaire.id, 'postulant': postulant.id}) }}">Accepter</a>
                <a class="{{ ui.btn('danger', beta, true) }}"
                   href="{{ path('groupeSecondaire.postulant.remove', {'groupeSecondaire': groupeSecondaire.id, 'postulant': postulant.id}) }}">Rejeter</a>
                <div class="dropdown">
                    <button class="{{ ui.more_button(beta) }}" type="button" data-bs-toggle="dropdown" aria-expanded="false"
                            aria-label="Répondre, mettre en attente"><i class="fa fa-ellipsis" aria-hidden="true"></i></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('groupeSecondaire.postulant.response', {'groupeSecondaire': groupeSecondaire.id, 'postulant': postulant.id}) }}"><i class="fa fa-reply" aria-hidden="true"></i> Répondre</a></li>
                        {% if not postulant.waiting %}
                            <li><a class="dropdown-item" href="{{ path('groupeSecondaire.postulant.wait', {'groupeSecondaire': groupeSecondaire.id, 'postulant': postulant.id}) }}"><i class="fa fa-hourglass-half" aria-hidden="true"></i> Mettre en attente</a></li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        {% else %}
            <span></span>
        {% endif %}
    </div>

    <div class="px-3 pb-3">
        <div class="small text-body-secondary">Message de candidature</div>
        <div class="gs-prose">{{ postulant.explanation|markdown_to_html }}</div>
    </div>
</div>

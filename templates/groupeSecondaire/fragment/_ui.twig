{#
Aides d'affichage de la page détail d'un groupe transverse.
Interface bêta (lm-design.css) : classes lm-*. Sinon : Bootstrap. `beta` vaut app.user.uiBeta.
#}

{# Classes d'un bouton. kind : primary, danger, default. #}
{% macro btn(kind, beta, small = false) %}
    {%- if beta -%}
        lm-btn{% if kind == 'primary' %} lm-btn--primary{% elseif kind == 'danger' %} lm-btn--danger{% endif %}{% if small %} lm-btn--sm{% endif %}
    {%- else -%}
        btn {% if kind == 'primary' %}btn-secondary{% elseif kind == 'danger' %}btn-outline-danger{% else %}btn-outline-secondary{% endif %}{% if small %} btn-sm{% endif %}
    {%- endif -%}
{% endmacro %}

{# Bouton « ⋯ » ouvrant un menu. #}
{% macro more_button(beta, label = 'Actions') %}
    {%- if beta -%}
        lm-btn lm-btn--icon lm-btn--sm
    {%- else -%}
        btn btn-sm btn-outline-secondary
    {%- endif -%}
{% endmacro %}

{# Pastille. role : secret, muted, ok, warn, info. #}
{% macro badge(label, role, beta, icon = null) %}
    {%- set bs = {'secret': 'text-bg-warning', 'muted': 'text-bg-secondary', 'ok': 'text-bg-success', 'warn': 'text-bg-warning', 'info': 'text-bg-info'} -%}
    <span class="{% if beta %}lm-badge{% else %}badge {{ bs[role]|default('text-bg-secondary') }}{% endif %}"{% if beta %} data-role="{{ role }}"{% endif %}>{% if icon %}<i class="fa {{ icon }}" aria-hidden="true"></i> {% endif %}{{ label }}</span>
{% endmacro %}

{# Avatar 44 px : trombinoscope si disponible, sinon initiales. #}
{% macro avatar(personnage, beta) %}
    {%- set parts = personnage.publicName|split(' ') -%}
    {%- set initials = (parts[0]|first ~ (parts[1]|default('')|first))|upper -%}
    <span class="{% if beta %}lm-avatar{% else %}d-inline-flex align-items-center justify-content-center rounded-circle border fw-bold text-body-secondary{% endif %} gs-avatar" aria-hidden="true">
        {%- if personnage.trombineUrl -%}
            <img src="{{ path('personnage.trombine', {'personnage': personnage.id}) }}" alt="" loading="lazy" width="44" height="44">
        {%- else -%}
            {{ initials }}
        {%- endif -%}
    </span>
{% endmacro %}

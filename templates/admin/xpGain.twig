{% extends "base.html.twig" %}

{% block title %}Technologie{% endblock title %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : 'Liste des gains de point XP' },
        ]
    } %}

    <div class="well well-sm">

        <div class="header">
            <h5>Liste des gains de points XP</h5>
        </div>

        {% include '_partials/formListSearch.twig' with
            {
                'actionPath' : path('xp.gain')
            } %}
    </div>

    {% include '_partials/pagination.html.twig' %}

    <div class="table-responsive">
    <table class="table table-sm table-striped table-bordered table-hover">
        {% include '_partials/thead.twig' with  { 'route': 'xp.gain', 'rows': [
            {'name' : 'Date', 'field' : 'operation_date', 'css' : 'text-center'},
            {'name' : 'Experience', 'field' : 'xp_gain', 'css' : 'text-center'},
            {'name' : 'Personnage', 'field' : 'personnage.id', 'css' : 'text-center'},
            {'name' : 'Explication', 'field' : 'explanation', 'css' : 'text-center'},
            {'name' : 'Retrait', 'css' : 'text-center'},
        ]} %}
        <tbody>
        {% for xp in paginator %}
            <tr>
                <td class="text-center align-middle col-2">{{ xp.operationDate|date("m/d/Y H:i:s")|highlight(pagerService.searchValue) }}</td>
                <td class="text-center align-middle col-1">{{ xp.xpGain|highlight(pagerService.searchValue) }}</td>
                <td class="align-middle col-4">
                    <a href="{{ path('personnage.detail', {'personnage': xp.personnage.id}) }}">
                        {{ xp.personnage.idName }}
                    </a>
                </td>
                <td class="align-middle col-3">
                    {% if xp.deleted %}<del>{{ xp.explanation }}</del> <span class="badge bg-secondary">retiré le {{ xp.deletedAt|date('d/m/Y') }}</span>{% else %}{{ xp.explanation }}{% endif %}
                </td>
                <td class="align-middle text-nowrap">
                    {% if not xp.deleted %}
                        <form method="post" action="{{ path('xp.gain.retirer', {gain: xp.id}) }}" class="d-flex gap-1"
                              onsubmit='return confirm("Retirer ce gain d’XP et corriger le solde du personnage ?");'>
                            <input type="hidden" name="_token" value="{{ csrf_token('xp_retrait_' ~ xp.id) }}">
                            <input class="form-control form-control-sm" name="motif" placeholder="Motif du retrait" required maxlength="200">
                            <select class="form-select form-select-sm" name="mode">
                                <option value="soft">Garder l'historique</option>
                                <option value="hard">Supprimer la ligne</option>
                            </select>
                            <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                        </form>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            {% include '_partials/noResultTableRow.twig' %}
        {% endfor %}
        </tbody>
    </table>
    </div>

    {% include '_partials/pagination.html.twig' %}


{% endblock %}

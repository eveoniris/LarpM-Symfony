{% extends "base.html.twig" %}

{% block title %}Archétype de secours{% endblock title %}

{% block body %}

    {% include '_partials/breadcrumb.twig' with {'items' :
        [
            {'name' : participant.gn.label, 'route': path('gn.detail', {'gn': participant.gn.id}) },
            {'name' : 'Détail de votre participation', 'route': path('participant.index', {'participant': participant.id}) },
            {'name' : "Choix de l'archétype de secours" }
        ]
    } %}

<div class="well well-sm">

    <div class="header">
        <h5><i class="fa fa-masks-theater" aria-hidden="true"></i> Choix de l'archétype de secours</h5>
    </div>

    {% set noticeHtml %}
        L'archétype de secours est le <strong>dernier maillon</strong> de votre chaîne de personnages :
        un personnage prêt à jouer, défini par sa seule classe, que vous endossez si votre
        <strong>personnage de relève</strong> vient lui aussi à trépasser.
        (Ce que nous ne souhaitons pas, mais l'Hyborée est un monde violent dans lequel les pires choses sont possibles.)
        <br/>
        Ce n'est <strong>pas</strong> un personnage de votre liste : pour cela, choisissez un
        <strong>personnage de relève</strong>.
    {% endset %}

    {% include '_partials/cardNotif.twig' with {'type' : 'info', 'content' : noticeHtml} %}

    {% include 'participant/fragment/chainePersonnages.twig' with {
        'participant': participant,
        'compact': true,
        'roleActif': 'archetype'
    } %}

    <div class="row">

        <div class="col-md-6">
            {{ form_start(form) }}
            <div class="card text-bg mb-3 overflow-auto">
                <div class="header"><h5>{{ field_label(form.personnageSecondaire) }}</h5></div>
                <div class="card-body">
                    {{ form_errors(form) }}

                    {{ form_widget(form.personnageSecondaire) }}

                    <div class="w-100 d-flex justify-content-center m-2">
                        {{ form_row(form.choice, { 'label': 'Enregistrer', 'attr' : {'class' : 'btn btn-secondary'} }) }}
                    </div>
                </div>
            </div>
            {{ form_end(form) }}
        </div>

        <div class="col-md-6">

            <div class="card text-bg mb-3 overflow-auto">
                <div class="header mb-0 pb-0"><h5 class="mb-0">Détail des archétypes</h5></div>
                <div class="card-body p-0">

                    <div class="table-responsive">
                    <table class="table table-sm table-striped table-bordered m-0">
                        <tbody>
                        {% for personnageSecondaire in personnageSecondaires %}
                            <tr>
                                <th>{{ personnageSecondaire.getLabelPourGenre(participant.personnage ? participant.personnage.genre : null) }}</th>
                                <td>
                                    {% include 'classe/fragment/competenceFamiliesBadges.twig' with {'competenceFamilies': personnageSecondaire.competences} %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endblock body %}

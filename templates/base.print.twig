<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">

    <title>LarpManager {% block title %}{% endblock title %}</title>

    <link rel="stylesheet" href="{{ asset('styles/lm-print.css') }}">
    <style>
        @page {
        {# Can be "landscape" instead #}
            size: {% block size %}A4{% endblock size %};
        }
    </style>

    {% block style %}
    {% endblock style %}
</head>
<body>
<div id="info"><button type="button" onclick="window.print()">Imprimer</button></div>
<div class="content">
    {% block content %}
    {% endblock content %}
</div>
</body>
</html>

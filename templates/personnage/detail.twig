{% extends "base.html.twig" %}

{% block title %}{{ personnage.nom }} détails{% endblock title %}

{% block body %}

    {% include 'personnage/fragment/breadcrumb.twig' %}

    {% set isAdmin = is_granted('ROLE_REGLE', app.user) or is_granted('ROLE_ADMIN', app.user) or is_granted('ROLE_SCENARISTE', app.user) %}

    <div class="panel mb-0 border-bottom-0">
        <div class="header">
            <h5>Fiche de personnage</h5>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-sm-between gap-1">

            <h3 class="mb-0">
                {% if isAdmin and personnage.isPnj() %}🎭 PNJ - {% endif %}
                {{ personnage.nom }}{% if personnage.surnom %} <small>({{ personnage.surnom }})</small>{% endif %}
            </h3>
            <div class="fs-5 d-flex align-items-center gap-2 flex-wrap">
                {% if personnage.genre == 'Masculin' %}
                    <i class="fa fa-mars" aria-hidden="true"></i>
                {% elseif personnage.genre == 'Feminin' %}
                    <i class="fa fa-venus" aria-hidden="true"></i>
                {% else %}
                    <i class="fa fa-transgender-alt" aria-hidden="true"></i>
                {% endif %}

                <small>{{ personnage.ageReel|default('x') }} ans ({{ personnage.age }})</small>

                {% if personnage.vivant %}<span class="text-success">Vivant</span>{% else %}<span
                        class="text-danger">💀 Mort</span>{% endif %}
            </div>
            <div class="fs-5">
                {{ personnage.classeName }}
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div>
                    <div class="personnage-actions d-none d-md-block">
                        <div class="btn-toolbar justify-content-end flex-wrap gap-1" role="toolbar" aria-label="Actions personnage">
                            <div class="btn-group flex-wrap" role="group" aria-label="Actions principales">
                                {% if personnage %}
                                    <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Choisir une nouvelle religion"
                                       href="{{ path('personnage.religion.add',{'personnage': personnage.id}) }}"><i
                                            class="fa fa-cloud"
                                            aria-hidden="true"></i><span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">Religion</span></a>
                                    <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Acheter une compétence"
                                       href="{{ path('personnage.add.competence', {'personnage': personnage.id}) }}"><i
                                                class="fa fa-graduation-cap" aria-hidden="true"></i><span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">Compétence</span></a>
                                    <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Modifier votre personnage"
                                       href="{{ path('personnage.update', {'personnage': personnage.id}) }}"><i
                                                class="fa fa-pencil" aria-hidden="true"></i>
                                        {% if personnage.isBraceletSetted == false %}
                                            <span class="position-absolute top-0 end-0 translate-middle badge z-3 p-1 bg-danger border border-light rounded-circle">
									        <span class="visually-hidden">!</span>
									    </span>
                                        {% endif %}
                                        <span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">Modifier</span>
                                    </a>
                                    {% if personnage.hasCompetence(constant('App\\Enum\\CompetenceFamilyType::MAGIC')) %}
                                        <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                           title="Découvrir la magie"
                                           href="{{ path('personnage.magie', {'personnage': personnage.id}) }}"><i
                                                    class="fa fa-magic"
                                                    aria-hidden="true"></i><span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">Magie</span></a>
                                    {% endif %}
                                    <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Imprimer votre personnage"
                                       href="{{ path('personnage.export', {'personnage':personnage.id}) }}"><i
                                                class="fa fa-print"
                                                aria-hidden="true"></i><span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">Imprimer</span></a>
                                    <a class="btn btn-secondary d-flex flex-column align-items-center" data-bs-toggle="tooltip" data-bs-placement="bottom"
                                       title="Imprimer votre personnage avec Qrcode"
                                       href="{{ path('personnage.export', {'personnage':personnage.id, 'qrCode':1}) }}"><i
                                                class="fa fa-qrcode"
                                                aria-hidden="true"></i><span class="d-block d-md-none" style="font-size:0.6rem;line-height:1">QR Code</span></a>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    {# Navigation mobile par offcanvas (visible uniquement sur xs/sm) #}
                    {% set tabLabels = {'general': 'Générale', 'competences': 'Compétences', 'religions': 'Religions', 'biographie': 'Biographie', 'groupes': 'Groupes', 'enveloppe': 'Enveloppe'} %}
                    {% set personnageTabItems = [
                        {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'general'})), 'label': 'Générale', 'active': tab == 'general'},
                        {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'competences'})), 'label': 'Compétences', 'active': tab == 'competences'},
                        {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'religions'})), 'label': 'Religions', 'active': tab == 'religions'},
                        {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'biographie'})), 'label': 'Biographie', 'active': tab == 'biographie'},
                        {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'groupes'})), 'label': 'Groupes', 'active': tab == 'groupes'},
                    ] %}
                    {% if isAdmin %}
                        {% set personnageTabItems = personnageTabItems|merge([
                            {'path': path('personnage.detail.tab', app.request.query.all|merge({'personnage': personnage.id, 'tab': 'enveloppe'})), 'label': 'Enveloppe', 'active': tab == 'enveloppe'},
                        ]) %}
                    {% endif %}
                    {# Barre mobile : onglets à gauche (avec le titre courant), actions à droite ; le panneau des actions sort de la droite #}
                    <div class="personnage-mobile-bar d-flex d-md-none align-items-stretch gap-2 mb-2">
                        {% include '_partials/offcanvasTabs.twig' with {
                            'offcanvasId': 'offcanvasPersonnageTabs',
                            'title': 'Navigation',
                            'triggerLabel': tabLabels[tab]|default('Navigation'),
                            'triggerPrefix': 'Onglet : ',
                            'triggerInline': true,
                            'groups': [{'items': personnageTabItems}]
                        } %}
                        <button class="btn btn-outline-primary personnage-actions-btn d-flex align-items-center gap-2 flex-shrink-0" type="button"
                                data-bs-toggle="offcanvas" data-bs-target="#offcanvasPersonnageActions"
                                aria-controls="offcanvasPersonnageActions">
                            <span class="position-relative d-flex align-items-center">
                                <i class="fa fa-bolt" aria-hidden="true"></i>
                                {% if personnage.isBraceletSetted == false %}
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"><span class="visually-hidden">À compléter</span></span>
                                {% endif %}
                            </span>
                            <span>Raccourcis</span>
                            <i class="fa fa-chevron-right" aria-hidden="true"></i>
                        </button>
                    </div>

                    <div class="offcanvas offcanvas-end d-md-none" tabindex="-1" id="offcanvasPersonnageActions" aria-labelledby="offcanvasPersonnageActionsLabel">
                        <div class="offcanvas-header border-bottom">
                            <h5 class="offcanvas-title d-flex align-items-center gap-2" id="offcanvasPersonnageActionsLabel"><i class="fa fa-bolt" aria-hidden="true"></i>Raccourcis</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fermer"></button>
                        </div>
                        <div class="offcanvas-body p-2">
                            <div class="list-group list-group-flush mb-1">
                                <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.religion.add', {'personnage': personnage.id}) }}"><i class="fa fa-cloud fa-fw me-2" aria-hidden="true"></i> Choisir une nouvelle religion</a>
                                <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.add.competence', {'personnage': personnage.id}) }}"><i class="fa fa-graduation-cap fa-fw me-2" aria-hidden="true"></i> Acheter une compétence</a>
                                <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.update', {'personnage': personnage.id}) }}"><i class="fa fa-pencil fa-fw me-2" aria-hidden="true"></i> Modifier le personnage{% if personnage.isBraceletSetted == false %} <span class="badge text-bg-danger">à compléter</span>{% endif %}</a>
                                {% if personnage.hasCompetence(constant('App\\Enum\\CompetenceFamilyType::MAGIC')) %}
                                    <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.magie', {'personnage': personnage.id}) }}"><i class="fa fa-magic fa-fw me-2" aria-hidden="true"></i> Découvrir la magie</a>
                                {% endif %}
                                <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.export', {'personnage': personnage.id}) }}"><i class="fa fa-print fa-fw me-2" aria-hidden="true"></i> Imprimer le personnage</a>
                                <a class="list-group-item list-group-item-action" data-turbo="false" href="{{ path('personnage.export', {'personnage': personnage.id, 'qrCode': 1}) }}"><i class="fa fa-qrcode fa-fw me-2" aria-hidden="true"></i> Imprimer avec QR Code</a>
                            </div>
                        </div>
                    </div>

                    {# Onglets desktop (cachés sur mobile) #}
                    <ul class="nav nav-tabs d-none d-md-flex" data-turbo="false">
                        <li class="nav-item">
                            <a class="nav-link{% if tab == 'general' %} active{% endif %}"
                               href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'general'})) }}"
                            >Générale</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link{% if tab == 'competences' %} active{% endif %}"
                               href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'competences'})) }}"
                            >Compétences</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link{% if tab == 'religions' %} active{% endif %}"
                               href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'religions'})) }}"
                            >Religions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link{% if tab == 'biographie' %} active{% endif %}"
                               href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'biographie'})) }}"
                            >Biographie</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link{% if tab == 'groupes' %} active{% endif %}"
                               href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'groupes'})) }}"
                            >Groupes</a>
                        </li>
                        {% if isAdmin %}
                            <li class="nav-item">
                                <a class="nav-link {% if tab == 'enveloppe' %} active{% endif %}"
                                   href="{{ path('personnage.detail.tab',  app.request.query.all|merge({'personnage': personnage.id,'tab': 'enveloppe'})) }}"
                                >Enveloppe</a>
                            </li>
                        {% endif %}
                    </ul>

                </div>
            </div>
        </div>
    </div>

    <!-- Tab panes -->
    <div class="tab-content" data-turbo="false">
        <div role="tabpanel" class="tab-pane active" role="tabpanel">
            {% include "personnage/fragment/tab_#{tab|default('detail')}.twig" with {'personnage': personnage, 'css': 'panel'} %}
        </div>
    </div>
{% endblock body %}

{% for domaine in domaines %}

    <div class="well well-sm">
        <div class="header">
            <h5>{{ domaine.label }}</h5>
        </div>
        <p>{{ domaine.description|markdown_to_html }}</p>
        <div class="list-group">
            {# sorts d'exemple filtrés côté serveur : niveau du mage, sans secrets non possédés (SEC-01) #}
            {% for sort in sortsExemples[domaine.id] ?? [] %}
                <div class="list-group-item">
                    <div class="list-group-item-heading">{{ sort.label }} - Niveau {{ sort.niveau }}</div>
                    <div class="list-group-item-text">{{ sort.description|markdown_to_html }}</div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endfor %}

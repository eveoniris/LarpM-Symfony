{% extends "base.html.twig" %}

{% block title %}{{ personnage.publicName }}{% endblock title %}

{% block body %}
    <div class="container-fluid"
         data-controller="confirm-choice"
         data-confirm-choice-message-value="Confirmez-vous vouloir prendre la religion {label} au niveau {niveau} ?">

        {% include 'personnage/fragment/breadcrumb.twig' with {'name': "Choix d'une religion"} %}

        <div class="well">
            <div class="header">
                <h5>Ajouter une religion</h5>
            </div>

            {% include '_partials/cardNotif.twig' with {
                'type' : 'warning',
                'content' : 'une fois votre religion choisie, vous ne pourrez plus revenir sur votre choix'} %}

            <div class="list-group-item-text">
                Vous pouvez choisir autant de religions que vous voulez. Attention toutefois, les règles suivantes
                s'appliquent :
                <ul>
                    <li>Vous ne pouvez avoir qu'une seule religion au niveau "Fervent"</li>
                    <li>Si vous choisissez une religion au niveau "Fanatique", vous perdez toutes vos autres religions
                        (un
                        Fanatique n'a qu'une seule religion).
                    </li>
                </ul>
            </div>

            {{ form_start(form, {'attr': {
                'data-confirm-choice-target': 'form',
                'data-action': 'submit->confirm-choice#submit'
            }}) }}
            {{ form_row(form.religionLevel) }}
            {{ form_row(form.religion) }}
            {{ form_row(form.save) }}
            {{ form_end(form) }}
        </div>

        <div class="well">
            <div class="header">
                <h5>Religions disponibles</h5>
            </div>
            <p class="text-muted">Choisissez d'abord votre degré de fanatisme, puis la religion.</p>

            <div class="row">
                {% for religion in religions %}
                    <div class="col-md-6 list-group mb-2">
                        <div class="list-group-item">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h6>{{ religion.label }}</h6>
                                <button type="button" class="btn btn-sm btn-secondary text-nowrap"
                                        data-action="confirm-choice#ask"
                                        data-confirm-choice-value-param="{{ religion.id }}"
                                        data-confirm-choice-target-param="religion">
                                    <i class="fa fa-plus"></i> Choisir
                                </button>
                            </div>
                            <div class="list-group-item-text">{{ religion.description|markdown_to_html }}</div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% include '_partials/confirmChoiceModal.twig' %}
    </div>
{% endblock body %}

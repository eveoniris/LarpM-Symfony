{% extends "base.html.twig" %}

{% block title %}Gn{% endblock title %}

{% block body %}

    <div class="well well-sm">
        {% include '_partials/breadcrumb.twig' with {'items' : [
            {'name' : 'Liste des grandeurs nature', 'route': path('gn.list') },
            {'name' : gn.label, 'route': path('gn.detail', {'gn':gn.id}) },
            {'name' : 'Les groupes recherchant des membres' }
        ]} %}

        <div class="card mb-3 border-info">
            <div class="card-header "><i class="fa fa-circle-info text-info"></i> Information</div>
            <div class="card-body">
                <p class="card-text">
                    Si vous voulez réserver un groupe, prennez une place "Réservation d'un groupe", et indiquez dans le
                    formulaire le nom du groupe que vous voulez réserver. La place PJ du chef de groupe est comprise
                    dans le tarif réservation de groupe.
                    Une fois votre paiement effectué, Eve-oniris recevra une notification et vous donnera les droits
                    necessaire pour que vous puissiez administrer votre groupe.
                </p>
            </div>
        </div>

        <div class="card mb-3 border-warning">
            <div class="card-header "><i class="fa fa-warning text-warning"></i> Attention</div>
            <div class="card-body">
                <p class="card-text">
                    Attention, le site HelloAsso qui nous permet de gérer les inscriptions en ligne va vous solliciter
                    pour vous demander un don, en effet, sa prestation est gratuite et il compte sur la générosité des
                    utilisateurs pour se rémunérer. Libre à vous d'accepter ou refuser, soyez-y simplement attentifs, il
                    vous le proposera par défaut.
                    Votre inscription sera prise en compte du point de vue du paiement, mais une démarche humaine est
                    nécessaire pour valider l'inscription sur larpmanager. Celle-ci sera effectuée dans les 3 jours
                    maximum après le paiement.
                </p>
            </div>
        </div>

        {% if helloassoEnabled and is_granted('ROLE_SUPER_ADMIN') %}
            <div class="card mb-3 border-primary" id="helloasso-sync">
                <div class="card-header"><i class="fa fa-rotate text-primary"></i> Synchronisation HelloAsso (bêta)</div>
                <div class="card-body">
                    {% if gn.helloassoEventId %}
                        <button type="button" class="btn btn-primary" id="helloasso-sync-btn">Contrôler la billetterie</button>
                        <a class="btn btn-outline-primary" href="{{ path('gn.billetterie.rapprochement', {'gn': gn.id}) }}">Tableau de rapprochement</a>
                        <div class="progress mt-3 d-none" id="helloasso-sync-progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                        </div>
                        <p class="mt-2 mb-0" id="helloasso-sync-status" role="status"></p>
                        <script>
                            (function () {
                                const btn = document.getElementById('helloasso-sync-btn');
                                const progress = document.getElementById('helloasso-sync-progress');
                                const status = document.getElementById('helloasso-sync-status');
                                const url = {{ path('gn.billetterie.sync', {'gn': gn.id})|json_encode|raw }};
                                const token = {{ csrf_token('billetterie_sync_' ~ gn.id)|json_encode|raw }};

                                async function lot(skip, tentative) {
                                    const body = new URLSearchParams({skip: skip, _token: token});
                                    try {
                                        const response = await fetch(url, {method: 'POST', body: body});
                                        const data = await response.json();
                                        if (!response.ok) {
                                            throw new Error(data.erreur || ('HTTP ' + response.status));
                                        }
                                        return data;
                                    } catch (error) {
                                        if (tentative < 2) {
                                            return lot(skip, tentative + 1);
                                        }
                                        throw error;
                                    }
                                }

                                btn.addEventListener('click', async function () {
                                    btn.disabled = true;
                                    progress.classList.remove('d-none');
                                    let skip = 0;
                                    try {
                                        let data;
                                        do {
                                            data = await lot(skip, 0);
                                            skip = data.suivant;
                                            status.textContent = skip + ' participant(s) traité(s)…';
                                        } while (!data.termine);
                                        status.textContent = skip + ' participant(s) synchronisé(s). Rendez-vous dans le tableau de rapprochement.';
                                    } catch (error) {
                                        status.textContent = 'Erreur : ' + error.message + ' (la synchronisation peut être relancée).';
                                    } finally {
                                        progress.classList.add('d-none');
                                        btn.disabled = false;
                                    }
                                });
                            })();
                        </script>
                    {% else %}
                        <p class="mb-0">Renseignez l'identifiant d'évènement HelloAsso dans la fiche du GN pour activer la synchronisation.</p>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <div class="row">
            <div class="col-md-5">
                En cas de problème d'affichage, utilisez <a
                    href="https://www.helloasso.com/associations/eve-oniris/evenements/legendes-d-hyboree-{{ gn.id }}">le
                    lien
                    suivant</a>.
                {{ gn.billetterie|raw }}
            </div>
            <div class="col-md-7">
                <div class="table-responsive">
                    <table class="table table-stripped table-sm">
                        <thead>
                        <tr>
                            <th>Numéro</th>
                            <th>Groupe</th>
                            <th>Statut</th>
                            <th>Chef de groupe</th>
                            <th>Pays</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for groupeGn in groupeGns %}
                            {% set oldGroupeGn = groupeGn.groupe.groupeGnById(max(1, groupeGn.gn.id )) %}
                            <tr>
                                <td>{{ groupeGn.groupe.numero }}</td>
                                <td>{{ groupeGn.groupe.nom }}</td>
                                <td>
                                    {% if groupeGn.free %}<span class="text-success">Libre</span>{% else %}<span
                                        class="text-danger">Reservé</span>{% endif %}</td>
                                <td>
                                    {% if groupeGn.responsable %}
                                        {{ groupeGn.responsable.user.etatCivil.prenom }} - {{ groupeGn.responsable.user.email }}
                                    {% endif %}

                                    {% if not oldGroupeGn %}
                                        <small>(Nouveau groupe)</small>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if groupeGn.groupe.territoire %}
                                        {{ groupeGn.groupe.territoire.nom }}
                                    {% else %}
                                        Rataché à aucun pays.
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

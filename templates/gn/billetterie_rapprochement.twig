{% extends "base.html.twig" %}

{% block title %}Rapprochement billetterie{% endblock title %}

{% block body %}
    {% set queryBase = {'gn': gn.id, 'etat': etat ? etat.value : 'tous', 'confiance': confiance ? confiance.value : '', 'status': status, 'produit': produit, 'q': q} %}
    <div class="well well-sm">
        {% include '_partials/breadcrumb.twig' with {'items' : [
            {'name' : 'Liste des grandeurs nature', 'route': path('gn.list') },
            {'name' : gn.label, 'route': path('gn.detail', {'gn':gn.id}) },
            {'name' : 'Billetterie', 'route': path('gn.billetterie', {'gn':gn.id}) },
            {'name' : 'Rapprochement HelloAsso' }
        ]} %}

        {# Correspondance produit HelloAsso + prix -> billet LarpManager #}
        {% set nbSansBillet = 0 %}
        {% for tarif in tarifs %}{% if tarif.billet == 0 %}{% set nbSansBillet = nbSansBillet + 1 %}{% endif %}{% endfor %}
        <details class="mb-3" {{ nbSansBillet > 0 ? 'open' : '' }}>
            <summary class="fw-bold">
                Tarifs HelloAsso et billets LarpManager
                {% if nbSansBillet > 0 %}<span class="badge bg-warning text-dark">{{ nbSansBillet }} tarif(s) sans billet</span>{% endif %}
            </summary>
            <form method="post" action="{{ path('gn.billetterie.produits', {'gn': gn.id}) }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('billetterie_sync_' ~ gn.id) }}">
                <p class="small text-muted mb-2">
                    Un tarif est un produit HelloAsso payé à un prix donné. Plusieurs tarifs peuvent mener au même billet
                    (dons solidaires), et un produit peut mener à des billets différents selon le prix.
                    « Prioritaire » : si le participant a aussi une autre ligne payée, ce billet l'emporte (place solidaire).
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                        <tr><th>Produit HelloAsso</th><th class="text-end">Prix</th><th class="text-end">Participants</th><th>Billet LarpManager</th><th class="text-center">Prioritaire</th></tr>
                        </thead>
                        <tbody>
                        {% for tarif in tarifs %}
                            <tr>
                                <td>
                                    {{ nomsProduits[tarif.product]|default('Produit sans nom') }}
                                    <br><small class="text-muted">{{ tarif.product }}</small>
                                    <input type="hidden" name="tarif[{{ loop.index0 }}][product]" value="{{ tarif.product }}">
                                    <input type="hidden" name="tarif[{{ loop.index0 }}][price]" value="{{ tarif.price }}">
                                </td>
                                <td class="text-end">{{ tarif.price is not null ? (tarif.price / 100)|number_format(2, ',', ' ') ~ ' €' : '-' }}</td>
                                <td class="text-end">
                                    <a href="{{ path('gn.billetterie.rapprochement', queryBase|merge({'produit': tarif.product, 'page': 1})) }}">{{ tarif.nb }}</a>
                                </td>
                                <td>
                                    <select name="tarif[{{ loop.index0 }}][billet]" class="form-select form-select-sm">
                                        <option value="0">Aucun billet</option>
                                        {% for billet in billets %}
                                            <option value="{{ billet.id }}" {{ billet.id == tarif.billet ? 'selected' : '' }}>{{ billet.label }}</option>
                                        {% endfor %}
                                    </select>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" name="tarif[{{ loop.index0 }}][prioritaire]" value="1" {{ tarif.prioritaire ? 'checked' : '' }}>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="text-muted text-center">Aucun produit. Lancez « Contrôler la billetterie » depuis la page billetterie.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                <button class="btn btn-primary btn-sm" type="submit">Enregistrer les tarifs</button>
                <span class="text-muted small">Les billets proposés des lignes « À valider » sont recalculés.</span>
            </form>
        </details>

        {# Compteurs par état #}
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <a class="btn btn-sm {{ etat is null ? 'btn-primary' : 'btn-outline-primary' }}"
               href="{{ path('gn.billetterie.rapprochement', queryBase|merge({'etat': 'tous', 'confiance': '', 'status': '', 'page': 1})) }}">Tous <span class="badge bg-secondary">{{ compteEtats|reduce((carry, nb) => carry + nb, 0) }}</span></a>
            {% for e in etats %}
                <a class="btn btn-sm {{ etat == e ? 'btn-primary' : 'btn-outline-primary' }}"
                   href="{{ path('gn.billetterie.rapprochement', queryBase|merge({'etat': e.value, 'confiance': '', 'status': '', 'page': 1})) }}">{{ e.label }} <span class="badge bg-secondary">{{ compteEtats[e.value]|default(0) }}</span></a>
            {% endfor %}

            <form method="post" class="ms-auto"
                  action="{{ path('gn.billetterie.valider_tout', {'gn': gn.id}) }}"
                  onsubmit="return confirm('Valider toutes les lignes sûres ou à e-mail unique, avec billet et payées ? Les lignes ambiguës ou sans correspondance sont ignorées.');">
                <input type="hidden" name="_token" value="{{ csrf_token('billetterie_sync_' ~ gn.id) }}">
                <button class="btn btn-success btn-sm" type="submit">Tout valider (lignes sûres)</button>
            </form>
        </div>

        {# Filtres #}
        <form method="get" class="row g-2 align-items-end mb-3" action="{{ path('gn.billetterie.rapprochement', {'gn': gn.id}) }}">
            <input type="hidden" name="etat" value="{{ etat ? etat.value : 'tous' }}">
            <div class="col-auto">
                <label class="form-label small mb-0" for="f-confiance">Confiance</label>
                <select id="f-confiance" name="confiance" class="form-select form-select-sm">
                    <option value="">Toutes</option>
                    {% for c in confiances %}
                        <option value="{{ c.value }}" {{ confiance == c ? 'selected' : '' }}>{{ c.label }} ({{ compteConfiances[c.value]|default(0) }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0" for="f-status">Statut HelloAsso</label>
                <select id="f-status" name="status" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    {% for s, nb in compteStatuts %}
                        <option value="{{ s }}" {{ status == s ? 'selected' : '' }}>{{ s }} ({{ nb }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0" for="f-produit">Produit</label>
                <select id="f-produit" name="produit" class="form-select form-select-sm">
                    <option value="">Tous</option>
                    {% for productId, nb in produits %}
                        <option value="{{ productId }}" {{ produit == productId ? 'selected' : '' }}>{{ nomsProduits[productId]|default(productId) }} ({{ nb }})</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0" for="f-q">Nom ou e-mail</label>
                <input id="f-q" type="search" name="q" value="{{ q }}" class="form-control form-control-sm">
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm" type="submit">Filtrer</button>
                <a class="btn btn-outline-secondary btn-sm" href="{{ path('gn.billetterie.rapprochement', {'gn': gn.id, 'etat': etat ? etat.value : 'tous'}) }}">Réinitialiser</a>
            </div>
        </form>

        {% include '_partials/pagination.html.twig' %}

        <div class="table-responsive">
            <table class="table table-striped table-sm align-middle">
                <thead>
                <tr>
                    <th>Participant HelloAsso</th>
                    <th>Produit</th>
                    <th>Statut</th>
                    <th>Prix</th>
                    <th>Confiance</th>
                    <th>Utilisateur / billet proposés</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for sync in paginator %}
                    <tr>
                        <td>{{ sync.nom }}<br><small>{{ sync.email }}</small>{% if sync.rawData._emailLarpManager is defined %}<br><small class="text-muted">compte déclaré : {{ sync.rawData._emailLarpManager }}</small>{% endif %}</td>
                        <td><small>{{ nomsProduits[sync.productId]|default(sync.productId) }}</small></td>
                        <td>{{ sync.status }}</td>
                        <td>{{ sync.price is not null ? (sync.price / 100)|number_format(2, ',', ' ') ~ ' €' : '' }}</td>
                        <td>{{ sync.confiance.label }}</td>
                        <td>
                            {% if sync.etat.value == 'a_valider' %}
                                <form method="post" class="d-flex flex-wrap gap-1"
                                      action="{{ path('gn.billetterie.valider', {'gn': gn.id, 'sync': sync.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('billetterie_sync_' ~ gn.id) }}">
                                    <input type="number" name="user_id" class="form-control form-control-sm w-auto"
                                           placeholder="ID utilisateur" value="{{ sync.user ? sync.user.id : '' }}"
                                           title="{{ sync.user ? sync.user.email : 'Aucun utilisateur proposé' }}">
                                    <select name="billet_id" class="form-select form-select-sm w-auto">
                                        <option value="">- billet -</option>
                                        {% for billet in billets %}
                                            <option value="{{ billet.id }}" {{ sync.billet and sync.billet.id == billet.id ? 'selected' : '' }}>{{ billet.label }}</option>
                                        {% endfor %}
                                    </select>
                                    <button class="btn btn-success btn-sm" type="submit">Valider</button>
                                </form>
                            {% else %}
                                {{ sync.user ? sync.user.email : '' }}{{ sync.billet ? ' / ' ~ sync.billet.label : '' }}
                            {% endif %}
                        </td>
                        <td>
                            {% if sync.etat.value == 'a_valider' %}
                                <form method="post" action="{{ path('gn.billetterie.ignorer', {'gn': gn.id, 'sync': sync.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('billetterie_sync_' ~ gn.id) }}">
                                    <button class="btn btn-outline-secondary btn-sm" type="submit">Ignorer</button>
                                </form>
                            {% else %}
                                {{ sync.etat.label }}
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="text-center text-muted">Aucune ligne pour ces filtres. Lancez « Contrôler la billetterie » depuis la page billetterie.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% include '_partials/pagination.html.twig' %}
    </div>
{% endblock %}

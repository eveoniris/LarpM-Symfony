{% extends "base.html.twig" %}

{# Interface bêta (lm-design) : les composants lm-* s'ajoutent à Bootstrap, les autres comptes gardent le rendu Bootstrap. #}
{% set beta = app.user is not null and app.user.uiBeta %}

{% block title %}Mon retour de jeu{% endblock title %}

{% block body %}

	{% include '_partials/breadcrumb.twig' with {'items' : [{'name' : 'GN ' ~ gn.label, 'route' : path('gn.detail', {'gn': gn.id})}, {'name' : 'Mon retour de jeu'}]} %}

	<header class="lm-page-head mb-3">
		<h1 class="lm-page-title h4 mb-1">Mon retour de jeu</h1>
		<p class="lm-meta mb-0">GN {{ gn.label }}</p>
	</header>

	<div class="alert alert-warning">
		Fonctionnalité en cours de test, réservée aux bêta-testeurs.
	</div>

	<div class="card mb-3 lm-carte-verre">
		<div class="card-body">
			{% if personnage %}
				<p>Vous allez ouvrir le retour de jeu de votre personnage <strong>{{ personnage.publicName }}</strong> (n° {{ personnage.id }}). Vous pouvez le compléter et le modifier tant qu'un organisateur n'a pas pris le relais ; rien n'est appliqué à votre personnage avant sa validation.</p>
				<form method="post" action="{{ path('depouillement.mon_retour', {'gn': gn.id}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('depouillement_mon_retour_' ~ gn.id) }}">
					<button type="submit" class="btn btn-primary"><i class="fa fa-folder-open"></i> Ouvrir mon retour de jeu</button>
				</form>
			{% else %}
				<p class="mb-0">Vous n'avez pas de personnage inscrit à ce GN : il n'y a pas de retour de jeu à ouvrir.</p>
			{% endif %}
		</div>
	</div>

{% endblock body %}

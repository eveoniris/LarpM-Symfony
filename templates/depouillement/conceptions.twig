{% extends "base.html.twig" %}

{# Interface bêta (lm-design) : les composants lm-* s'ajoutent à Bootstrap, les autres comptes gardent le rendu Bootstrap. #}
{% set beta = app.user is not null and app.user.uiBeta %}

{% block title %}Conceptions d'héritier{% endblock title %}

{% block body %}

	{% include '_partials/breadcrumb.twig' with {'items' : [{'name' : 'GN ' ~ gn.label, 'route' : path('gn.detail', {'gn': gn.id})}, {'name' : 'Dépouillement des enveloppes', 'route' : path('depouillement.index', {'gn': gn.id})}, {'name' : 'Conceptions d\'héritier'}]} %}

	<header class="lm-page-head mb-3">
		<h1 class="lm-page-title h4 mb-1">Conceptions d'héritier</h1>
		<p class="lm-meta mb-0">GN {{ gn.label }}</p>
	</header>

	<div class="alert alert-info small">
		Le tirage (d20) n'est qu'une <strong>suggestion</strong> : vous décidez de créer le ou les héritiers, de gérer la création vous-même plus tard (remarque obligatoire) ou de clôturer. Un héritier est créé sans joueur, à 0 an, avec la classe secrète : à changer avant qu'un joueur reprenne le personnage. Les conceptions issues d'une simulation ne créent jamais d'héritier.
	</div>

	{% for c in conceptions %}
		<div class="card mb-3 lm-carte-verre">
			<div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-1">
				<span>
					<strong>{{ c.parent1.nom }}</strong> (n°{{ c.parent1.id }}) et <strong>{{ c.parent2.nom }}</strong> (n°{{ c.parent2.id }})
					{% if c.simulation %}<span class="badge text-bg-warning">simulation</span>{% endif %}
				</span>
				<span class="badge text-bg-secondary">{{ c.statut.label }}</span>
			</div>
			<div class="card-body">
				<p class="mb-1">
					{% if c.tirage is not null %}Tirage : <strong>{{ c.tirage }}</strong>, {{ c.issue.label }}{% else %}Pas de tirage (âge d'un parent){% endif %}
				</p>
				{% if c.note %}<p class="mb-1">Note des joueurs : {{ c.note|nl2br }}</p>{% endif %}
				{% for anomalie in c.anomalies %}<div class="small lm-anomalie"><i class="fa fa-triangle-exclamation"></i> {{ anomalie }}</div>{% endfor %}
				{% if c.remarque %}<p class="mb-1">Remarque : {{ c.remarque|nl2br }}</p>{% endif %}
				{% if c.heritiers|length > 0 %}
					<p class="mb-1">Héritiers créés : {% for id in c.heritiers %}<a href="{{ path('personnage.detail', {'personnage': id}) }}">n°{{ id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
				{% endif %}

				{% if c.statut.value == 'en_attente' and not c.simulation %}
					{% set f = formulaires[c.id] %}
					<details class="mt-2" {% if f.vars.submitted %}open{% endif %}>
						<summary class="h6">Créer le ou les héritiers</summary>
						{{ form_start(f) }}
						<div class="row">
							<div class="col-md-6">
								<h6>Premier héritier</h6>
								{{ form_row(f.premier.nom) }}{{ form_row(f.premier.genre) }}{{ form_row(f.premier.territoire) }}{{ form_row(f.premier.langueParents) }}{{ form_row(f.premier.lignee) }}
							</div>
							<div class="col-md-6">
								<h6>Second héritier (jumeaux), laisser le nom vide sinon</h6>
								{{ form_row(f.second.nom) }}{{ form_row(f.second.genre) }}{{ form_row(f.second.territoire) }}{{ form_row(f.second.langueParents) }}{{ form_row(f.second.lignee) }}
							</div>
						</div>
						{{ form_widget(f.submit, {'attr': {'class': 'btn btn-primary'}}) }}
						{{ form_end(f) }}
					</details>

					<form method="post" class="row g-2 mt-2 align-items-end">
						<input type="hidden" name="_token" value="{{ csrf_token('conception_decision_' ~ c.id) }}">
						<div class="col-md-6">
							<label for="remarque-{{ c.id }}" class="form-label">Remarque (obligatoire)</label>
							<input type="text" id="remarque-{{ c.id }}" name="remarque" class="form-control">
						</div>
						<div class="col-auto">
							<button type="submit" formaction="{{ path('depouillement.conception.plus_tard', {'gn': gn.id, 'conception': c.id}) }}" class="btn btn-outline-secondary">Gérer plus tard</button>
							<button type="submit" formaction="{{ path('depouillement.conception.cloturer', {'gn': gn.id, 'conception': c.id}) }}" class="btn btn-outline-danger" onclick="return confirm('Clôturer sans créer d\'héritier ?');">Clôturer</button>
						</div>
					</form>
				{% endif %}
			</div>
		</div>
	{% else %}
		<p class="text-muted">Aucune conception signalée dans ce GN.</p>
	{% endfor %}

{% endblock body %}

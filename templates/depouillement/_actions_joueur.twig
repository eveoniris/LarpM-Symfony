{# Étape « Actions de fin d'Opus » d'une enveloppe de joueur : les six actions, une fois par GN chacune.
   Variables : contenuJoueur, formContenuJoueur (null si non modifiable), resultatsActions, actionsFinOpus #}

<h6>Actions de fin d'Opus <small class="text-muted">(une fois par GN chacune)</small></h6>
<p class="small text-muted">Cochez « Action utilisée » si le joueur a joué l'action, puis « Ressources jointes » si les ressources exigées sont bien dans l'enveloppe. Une action <strong>refusée</strong> (ressources absentes) est simplement sans effet : rien n'est bloqué, l'enregistrement et la suite du parcours restent possibles. Les remarques en orange sont à vérifier, jamais bloquantes.</p>

{% if formContenuJoueur %}
	{% set f = formContenuJoueur %}
	{{ form_start(f, {'attr': {'data-lm-unsaved': ''}}) }}

	{% set champs = {
		'fruits_legumes': ['fruitsUtilise', 'fruitsJointes', null],
		'soie': ['soieUtilise', 'soieJointes', null],
		'gemme': ['gemmeUtilise', 'gemmeJointes', 'gemmePieces'],
		'sel': ['selUtilise', 'selJointes', 'selIngredients'],
		'fourrure': ['fourrureUtilise', 'fourrureJointes', 'fourrureRessources'],
		'ivoire': ['ivoireUtilise', 'ivoireJointes', 'ivoirePotions']
	} %}
	{% for a in actionsFinOpus %}
		{% set c = champs[a.value] %}
		{% set resultat = resultatsActions[a.value] %}
		<div class="card mb-2 lm-carte-verre">
			<div class="card-header py-1 d-flex justify-content-between align-items-center flex-wrap gap-1">
				<span>{{ a.label }}</span>
				<span class="badge {{ resultat.statut.value == 'acceptee' ? 'text-bg-success' : (resultat.statut.value == 'refusee' ? 'text-bg-warning' : 'text-bg-secondary') }}"{% if resultat.statut.value == 'refusee' %} title="Cette action n'aura pas d'effet. Cela ne bloque pas l'enregistrement."{% endif %}>{{ resultat.statut.label }}{% if resultat.statut.value == 'refusee' %} : sans effet, non bloquant{% endif %}</span>
			</div>
			<div class="card-body py-2">
				<div class="small text-muted mb-1">Consomme {{ a.quantiteRessource }} {{ a.ressource }} : {{ a.effet }}.</div>
				{{ form_row(f[c[0]]) }}
				{{ form_row(f[c[1]]) }}
				{% if c[2] %}{{ form_row(f[c[2]]) }}{% endif %}
				{% for anomalie in resultat.anomalies %}<div class="small lm-anomalie"><i class="fa fa-triangle-exclamation"></i> {{ anomalie }}</div>{% endfor %}
			</div>
		</div>
	{% endfor %}

	{{ form_widget(f.submit, {'attr': {'class': 'btn btn-primary w-100 w-md-auto'}}) }}
	{{ form_end(f) }}
{% else %}
	{% set utilisees = actionsFinOpus|filter(a => resultatsActions[a.value].statut.value != 'non_utilisee') %}
	<ul>
		{% for a in utilisees %}
			{% set resultat = resultatsActions[a.value] %}
			<li>
				{{ a.label }} : <strong>{{ resultat.statut.label }}</strong>{% if resultat.effet %} ({{ resultat.effet }}){% endif %}
			</li>
		{% else %}
			<li>Aucune action utilisée.</li>
		{% endfor %}
	</ul>
{% endif %}

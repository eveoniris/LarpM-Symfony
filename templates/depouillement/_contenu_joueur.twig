{# Étape « Contenu » d'une enveloppe de joueur, d'après la fiche "Instructions Retour de jeu JOUEUR" : pièces jointes, ressources
   trouvées, apprentissages. Les actions de fin d'Opus ont leur étape (_actions_joueur.twig).
   Variables : contenuJoueur, formContenuJoueur (null si non modifiable), anomaliesContenu #}

<h6>Contenu de l'enveloppe de joueur</h6>
<p class="text-muted small">
	Listez ici tout ce qui se trouve dans l'enveloppe. Les actions de fin d'Opus se décident à l'étape suivante. Seuls les pièces, ressources, potions et ingrédients conservés ou utilisés dans ces actions doivent rester dans l'enveloppe du joueur : <strong>tout le reste est du surplus à mettre dans l'enveloppe de groupe</strong> (il sert au calcul de l'initiative du groupe).
</p>

{% if anomaliesContenu|length > 0 %}
	<div class="alert alert-warning small">
		<strong><i class="fa fa-triangle-exclamation"></i> À signaler ou à vérifier (non bloquant) :</strong>
		<ul class="mb-0">
			{% for anomalie in anomaliesContenu %}<li>{{ anomalie }}</li>{% endfor %}
		</ul>
	</div>
{% endif %}

{% if formContenuJoueur %}
	{% set f = formContenuJoueur %}
	{{ form_start(f, {'attr': {'data-lm-unsaved': ''}}) }}

	{# Seules les pièces qui concernent le profil du personnage sont demandées ; les autres restent accessibles, repliées. #}
	{% set pieces = ['fichePersonnage', 'ficheRetour', 'ficheSort', 'fichePriere', 'carteAlchimiste', 'copiesRecettesSorts', 'corruptionOuvertes', 'corruptionNonOuvertes', 'pincesALinge'] %}
	{% set attendues = pieces|filter(nom => piecesAttendues[nom] ?? true) %}
	{% set inattendues = pieces|filter(nom => not (piecesAttendues[nom] ?? true)) %}
	{% set inattenduesUtilisees = inattendues|filter(nom => attribute(contenuJoueur, nom)) %}
	<fieldset class="mb-3">
		<legend class="h6">Pièces jointes à l'enveloppe</legend>
		{% if profilPersonnage %}
			<p class="small text-muted">Profil du personnage : <strong>{{ profilPersonnage }}</strong>. Seules les pièces qui le concernent sont demandées ; les autres sont dans « Autres pièces ».</p>
		{% endif %}
		<div class="row row-cols-1 row-cols-md-2 g-1">
			{% for nom in attendues %}
				<div class="col">{{ form_row(f[nom]) }}</div>
			{% endfor %}
		</div>
		{{ form_row(f.documentsNumerotes) }}
		{% if inattendues|length > 0 %}
			<details class="mt-2" {{ inattenduesUtilisees|length > 0 ? 'open' : '' }}>
				<summary class="small">Autres pièces (non attendues pour ce profil)</summary>
				<p class="small text-muted mb-1">À cocher seulement si elles se trouvent quand même dans l'enveloppe.</p>
				<div class="row row-cols-1 row-cols-md-2 g-1">
					{% for nom in inattendues %}
						<div class="col">{{ form_row(f[nom]) }}</div>
					{% endfor %}
				</div>
			</details>
		{% endif %}
	</fieldset>

	<details class="mb-3" open>
		<summary class="h6">Ressources et pièces trouvées dans l'enveloppe</summary>
		<p class="text-muted small">Indiquez les quantités trouvées. Rien n'est perdu : tout le reliquat est crédité au groupe pour son initiative.</p>
		<div class="row row-cols-2 row-cols-md-3 g-1">
			{% for champ in f.surplus %}
				<div class="col">{{ form_row(champ) }}</div>
			{% endfor %}
		</div>
	</details>

	<fieldset class="mb-3">
		<legend class="h6">Appris pendant le jeu</legend>
		{{ form_row(f.sorts) }}
		{{ form_row(f.prieres) }}
		{{ form_row(f.potions) }}
		<div class="row g-2">
			<div class="col-12 col-md-8">{{ form_row(f.competenceApprise) }}</div>
			<div class="col-12 col-md-4">{{ form_row(f.enseignantNumero) }}</div>
		</div>
		{{ form_row(f.introuvables) }}
	</fieldset>

	<fieldset class="mb-3">
		<legend class="h6">État du personnage</legend>
		{{ form_row(f.personnageMort) }}
		{{ form_row(f.circonstancesMort) }}
	</fieldset>

	{{ form_widget(f.submit, {'attr': {'class': 'btn btn-primary w-100 w-md-auto'}}) }}
	{{ form_end(f) }}
{% else %}
	<h6>Pièces jointes à l'enveloppe</h6>
	{% set pieces = {
		'Fiche de personnage': contenuJoueur.fichePersonnage,
		'Fiche de retour joueur remplie': contenuJoueur.ficheRetour,
		'Fiche de sort': contenuJoueur.ficheSort,
		'Fiche de prière': contenuJoueur.fichePriere,
		'Carte alchimiste ou herboriste': contenuJoueur.carteAlchimiste,
		'Copies des recettes et des sorts appris': contenuJoueur.copiesRecettesSorts
	} %}
	<p class="mb-1">{{ pieces|filter(p => p)|keys|join(', ') ?: 'Aucune pièce cochée.' }}</p>
	<p class="mb-1">Enveloppes de corruption : {{ contenuJoueur.corruptionOuvertes }} ouverte(s), {{ contenuJoueur.corruptionNonOuvertes }} non ouverte(s) ; pinces à linge : {{ contenuJoueur.pincesALinge }}{% if contenuJoueur.documentsNumerotes %} ; documents numérotés : {{ contenuJoueur.documentsNumerotes }}{% endif %}</p>
	<h6 class="mt-2">Appris pendant le jeu</h6>
	<p class="mb-1">Sorts : {{ contenuJoueur.sorts|map(s => s.label)|join(', ') ?: '-' }}</p>
	<p class="mb-1">Prières : {{ contenuJoueur.prieres|map(p => p.label)|join(', ') ?: '-' }}</p>
	<p class="mb-1">Potions : {{ contenuJoueur.potions|map(p => p.label)|join(", ") ?: "-" }}</p>
	<p class="mb-1">Compétence apprise : {% if contenuJoueur.competenceApprise %}{{ contenuJoueur.competenceApprise.label }}, enseignée par le personnage n° {{ contenuJoueur.enseignantNumero ?: '?' }}{% else %}-{% endif %}</p>
	<h6 class="mt-2">Ressources et pièces trouvées</h6>
	<p class="mb-1">
		{% for libelle, quantite in trouveLibelles %}{{ libelle }} : {{ quantite }}{% if not loop.last %}, {% endif %}{% else %}-{% endfor %}
	</p>
	<p class="mb-0">Personnage mort pendant cet opus : <strong>{{ contenuJoueur.personnageMort ? 'oui' : 'non' }}</strong>{% if contenuJoueur.personnageMort and contenuJoueur.circonstancesMort %} ({{ contenuJoueur.circonstancesMort }}){% endif %}</p>
{% endif %}

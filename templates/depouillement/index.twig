{% extends "base.html.twig" %}

{# Interface bêta (lm-design) : les composants lm-* s'ajoutent à Bootstrap, les autres comptes gardent le rendu Bootstrap. #}
{% set beta = app.user is not null and app.user.uiBeta %}

{% block title %}Dépouillement des enveloppes{% endblock title %}

{% block body %}

	{% include '_partials/breadcrumb.twig' with {'items' : [{'name' : 'GN ' ~ gn.label, 'route' : path('gn.detail', {'gn': gn.id})}, {'name' : 'Dépouillement des enveloppes'}]} %}

	<header class="lm-page-head mb-3">
		<h1 class="lm-page-title h4 mb-1">Dépouillement des enveloppes</h1>
		<p class="lm-meta mb-0">GN {{ gn.label }}</p>
	</header>

	<div class="alert alert-warning">
		Fonctionnalité en cours de test, réservée aux bêta-testeurs. Pour l'instant seules les <strong>simulations</strong> sont possibles : elles n'ont aucun effet sur les joueurs ni sur les groupes et peuvent être supprimées à tout moment.
	</div>

	<div class="card mb-3 lm-carte-verre">
		<div class="card-header">Nouvelle simulation</div>
		<div class="card-body">
			{{ form_start(form) }}
			{{ form_widget(form) }}
			{{ form_end(form) }}
		</div>
	</div>

	<div class="well well-sm lm-carte-verre">
		<div class="{{ beta ? 'mb-2' : 'header' }}">
			<h5 class="{{ beta ? 'lm-card-title' : '' }}">Simulations de ce GN <small>({{ simulations|length }})</small></h5>
		</div>
		{% if simulations|length > 0 %}
			<form method="post" action="{{ path('depouillement.purge', {'gn': gn.id}) }}" data-lm-confirm="Supprimer toutes les simulations de ce GN ?" data-lm-confirm-danger data-lm-confirm-label="Supprimer">
				<input type="hidden" name="_token" value="{{ csrf_token('depouillement_purge_' ~ gn.id) }}">
				<button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Purger les simulations</button>
			</form>
		{% endif %}
	</div>

	<div class="{{ beta ? 'lm-table-wrap' : 'table-responsive' }}">
		<table class="{{ beta ? 'lm-table' : 'table table-bordered table-striped' }}">
			<thead>
				<tr>
					<th>Enveloppe</th>
					<th>Numéro</th>
					<th>Concerne</th>
					<th>Statut</th>
					<th>Dépouilleur</th>
					<th>Créée le</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for simulation in simulations %}
					<tr>
						<td>{{ simulation.type.label }}</td>
						<td>{{ simulation.numero }}</td>
						<td>
							{% if simulation.groupeGn %}{{ simulation.groupeGn.groupe.nom }}{% elseif simulation.participant and simulation.participant.user %}{{ simulation.participant.user.username }}{% else %}-{% endif %}
						</td>
						<td>{{ simulation.statut.label }}</td>
						<td>{{ simulation.depouilleur ? simulation.depouilleur.username : '-' }}</td>
						<td>{{ simulation.createdAt|date('d/m/Y H:i') }}</td>
						<td class="text-nowrap">
							<a class="btn btn-sm btn-primary" href="{{ path('depouillement.etape', {'gn': gn.id, 'depouillement': simulation.id, 'etape': (simulation.statut.editable ? 'identification' : 'recapitulatif')}) }}"><i class="fa fa-folder-open"></i> Ouvrir</a>
							<form class="d-inline" method="post" action="{{ path('depouillement.delete', {'gn': gn.id, 'depouillement': simulation.id}) }}" data-lm-confirm="Supprimer cette simulation ?" data-lm-confirm-danger data-lm-confirm-label="Supprimer">
								<input type="hidden" name="_token" value="{{ csrf_token('depouillement_delete_' ~ simulation.id) }}">
								<button type="submit" class="btn btn-sm btn-danger" title="Supprimer cette simulation"><i class="fa fa-trash"></i> Supprimer</button>
							</form>
						</td>
					</tr>
				{% else %}
					<tr><td colspan="7" class="text-muted">Aucune simulation.</td></tr>
				{% endfor %}
			</tbody>
		</table>
	</div>

{% endblock body %}

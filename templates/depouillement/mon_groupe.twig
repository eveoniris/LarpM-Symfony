{% extends "base.html.twig" %}

{# Interface bêta (lm-design) : les composants lm-* s'ajoutent à Bootstrap, les autres comptes gardent le rendu Bootstrap. #}
{% set beta = app.user is not null and app.user.uiBeta %}

{% block title %}Retour de jeu de mon groupe{% endblock title %}

{% block body %}

	{% include '_partials/breadcrumb.twig' with {'items' : [{'name' : 'GN ' ~ gn.label, 'route' : path('gn.detail', {'gn': gn.id})}, {'name' : 'Retour de mon groupe'}]} %}

	<header class="lm-page-head mb-3">
		<h1 class="lm-page-title h4 mb-1">Retour de jeu de mon groupe</h1>
		<p class="lm-meta mb-0">GN {{ gn.label }}</p>
	</header>

	<div class="alert alert-warning">
		Fonctionnalité en cours de test, réservée aux bêta-testeurs.
	</div>

	<div class="card mb-3 lm-carte-verre">
		<div class="card-body">
			{% if groupeGn %}
				<p>Vous allez ouvrir le retour de jeu du groupe <strong>{{ groupeGn.groupe.nom }}</strong> (n° {{ groupeGn.groupe.numero }}). Le chef de groupe et les titulaires des six titres le remplissent ensemble ; vous pouvez le compléter tant qu'un organisateur n'a pas pris le relais, et rien n'est appliqué avant sa validation.</p>
				<form method="post" action="{{ path('depouillement.mon_groupe', {'gn': gn.id}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('depouillement_mon_groupe_' ~ gn.id) }}">
					<button type="submit" class="btn btn-primary"><i class="fa fa-folder-open"></i> Ouvrir le retour de mon groupe</button>
				</form>
			{% else %}
				<p class="mb-0">Vous n'êtes ni chef de groupe ni titulaire d'un titre de groupe à ce GN : il n'y a pas de retour de groupe à ouvrir.</p>
			{% endif %}
		</div>
	</div>

{% endblock body %}

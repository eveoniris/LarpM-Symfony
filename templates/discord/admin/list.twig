{% extends "base.html.twig" %}

{% block title %}Bot Discord{% endblock title %}

{% block body %}

    <ol class="breadcrumb">
        <li><a href="{{ path('homepage') }}">Accueil</a></li>
        <li class="active">Bot Discord</li>
    </ol>

    {% for error in errors %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endfor %}

    <div class="well bs-component">
        <h3>Guildes Discord configurées</h3>
        <p class="text-muted small">
            Chaque guilde (serveur Discord) a sa propre correspondance entre les rôles LarpManager et ses rôles Discord.
        </p>

        {% if guilds is empty %}
            <p>Aucune guilde configurée.</p>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <thead>
                    <tr>
                        <th>Nom</th>
                        <th>ID Discord</th>
                        <th>Rôles configurés</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for guild in guilds %}
                        <tr>
                            <td>{{ guild.nom }}</td>
                            <td><code>{{ guild.guildId }}</code></td>
                            <td>{{ guild.mappings|length }}</td>
                            <td>
                                <a class="btn btn-sm btn-primary"
                                   href="{{ path('discord.admin.guilde', {'guild': guild.id}) }}">Configurer</a>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <div class="well bs-component">
        <h3>Ajouter une guilde</h3>
        <form method="POST" action="{{ path('discord.admin') }}" class="row g-2">
            <input type="hidden" name="_token" value="{{ csrf_token('discord_guilde_add') }}">
            <div class="col-md-4">
                <label class="form-label" for="input-nom">Nom</label>
                <input class="form-control" id="input-nom" name="nom" maxlength="100" required
                       value="{{ old.nom|default('') }}">
            </div>
            <div class="col-md-5">
                <label class="form-label" for="input-guild-id">ID de la guilde</label>
                <input class="form-control" id="input-guild-id" name="guild_id" inputmode="numeric" required
                       value="{{ old.guild_id|default('') }}">
                <div class="form-text">Discord, mode développeur : clic droit sur le serveur puis « Copier l'identifiant ».</div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-primary" type="submit">Ajouter</button>
            </div>
        </form>
    </div>

{% endblock body %}

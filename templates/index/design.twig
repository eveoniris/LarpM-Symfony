{% extends "base.html.twig" %}

{% block title %}Template de design{% endblock title %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/lm-design.css') }}">
{% endblock %}

{% block body %}
    {# Nécessite assets/styles/lm-design.css chargé dans base.html.twig #}
    <style>
.doc{max-width:980px;margin:0 auto;background:var(--lm-bg);padding:var(--lm-s5);border:1px solid var(--lm-line);border-radius:var(--lm-radius-lg);display:flex;flex-direction:column;gap:var(--lm-s6);font:400 1rem/1.6 var(--lm-font-body);color:var(--lm-fg)}
.doc h1,.doc h2,.doc h3,.doc h4{font-family:var(--lm-font-display);text-wrap:balance;line-height:1.25;color:var(--lm-fg)}
.doc h1{font-size:clamp(1.7rem,5vw,2.4rem);margin:.2rem 0 .6rem;letter-spacing:.02em}
.doc h2{font-size:1.4rem;margin:0 0 var(--lm-s4);padding-bottom:var(--lm-s2);border-bottom:1px solid var(--lm-line)}
.doc h3{font-size:1.05rem;margin:var(--lm-s5) 0 var(--lm-s3);letter-spacing:.04em}
.doc-kicker{font:400 .75rem var(--lm-font-mono);letter-spacing:.12em;text-transform:uppercase;color:var(--lm-accent)}
.doc-lead{color:var(--lm-muted);font-size:1.1rem;max-width:68ch;margin:0 0 var(--lm-s4)}
.doc-note{color:var(--lm-muted);font-size:.9rem;max-width:72ch;margin:var(--lm-s3) 0 0}
.doc code{font-family:var(--lm-font-mono);font-size:.84em;background:var(--lm-raised);padding:1px 5px;border-radius:4px}
.doc pre.code{font:400 .8rem/1.7 var(--lm-font-mono);background:var(--lm-surface);border:1px solid var(--lm-line);border-radius:var(--lm-radius);padding:var(--lm-s4);overflow-x:auto;margin:0;color:var(--lm-fg)}
.doc .sample{border:1px dashed var(--lm-line);border-radius:var(--lm-radius-lg);padding:var(--lm-s4);background:color-mix(in srgb,var(--lm-surface) 60%,transparent)}
.doc .doc-rules{margin:0;padding-left:1.2rem;display:grid;gap:var(--lm-s2);align-content:start}
.doc .doc-sec,.doc .lm-stack{min-width:0}
.doc h4.lm-page-title{font-size:1.4rem}
@media (max-width:640px){.doc h2{font-size:1.2rem}}
    </style>

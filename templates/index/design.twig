      <li class="lm-seat"><svg class="lm-ico"><use href="#i-target"/></svg><span class="lm-seat-role">Stratège</span><span class="lm-seat-name">Brann Mac Ardal</span></li>
      <li class="lm-seat"><svg class="lm-ico"><use href="#i-compass"/></svg><span class="lm-seat-role">Navigateur</span><span class="lm-seat-name">Thalia de Zamora</span></li>
      <li class="lm-seat"><svg class="lm-ico"><use href="#i-eye"/></svg><span class="lm-seat-role">Éminence grise</span><span class="lm-seat-name">Kaelwyn le Borgne</span></li>
      <li class="lm-seat"><svg class="lm-ico"><use href="#i-balance"/></svg><span class="lm-seat-role">Diplomate</span><span class="lm-seat-name">Kaelwyn le Borgne</span></li>
      <li class="lm-seat is-vacant"><svg class="lm-ico"><use href="#i-users"/></svg><span class="lm-seat-role">Chef de groupe</span><span class="lm-seat-name">Siège vacant</span></li>
    </ul>
    <div class="lm-kpis">
      <div class="lm-kpi"><span class="lm-kpi-value">18</span><span class="lm-kpi-label">Initiative</span></div>
      <div class="lm-kpi"><span class="lm-kpi-value">3</span><span class="lm-kpi-label"><svg class="lm-ico"><use href="#i-landmark"/></svg> Fiefs</span></div>
      <div class="lm-kpi"><span class="lm-kpi-value">0</span><span class="lm-kpi-label"><svg class="lm-ico"><use href="#i-castle"/></svg> Armes de siège</span></div>
      <div class="lm-kpi"><span class="lm-kpi-value">8</span><span class="lm-kpi-label"><svg class="lm-ico"><use href="#i-users"/></svg> Agents</span></div>

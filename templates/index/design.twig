    </ul>
    <div class="lm-kpis">
      <div class="lm-kpi"><span class="lm-kpi-value">18</span><span class="lm-kpi-label">Initiative</span></div>
      <div class="lm-kpi"><span class="lm-kpi-value">3</span><span class="lm-kpi-label"><svg class="lm-ico"><use href="#i-landmark"/></svg> Fiefs</span></div>

# Template de surcharge locale pour développeurs sans droits admin.
#
# Copier ce fichier en .env.dev.local (gitignored) pour désactiver
# le HTTPS automatique et travailler sur http://localhost:8080
# sans modifier le fichier hosts ni installer de certificat.
#
# Usage :
#   cp docker/.env.dev.local.dist .env.dev.local
#   docker compose up -d
#   → http://localhost:8080

SERVER_NAME=":8080"
CADDY_GLOBAL_OPTIONS="auto_https off"
DEFAULT_URI=http://localhost:8080

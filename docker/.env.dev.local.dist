# Surcharge locale optionnelle : activer le HTTPS (certificat local Caddy).
#
# Par défaut le stack dev tourne en HTTP sur http://localhost (aucun setup).
# Copier ce fichier en .env.dev.local (gitignored) pour servir aussi
# https://localhost et https://larpmanager.test.
# Prérequis : entrée hosts + import de la CA Caddy (voir docker/README.md).
#
# Usage :
#   cp docker/.env.dev.local.dist .env.dev.local
#   docker compose up -d
#   -> https://larpmanager.test

SERVER_NAME="localhost, larpmanager.test"
CADDY_GLOBAL_OPTIONS="local_certs"
DEFAULT_URI=https://larpmanager.test

# Modèle d'environnement pour la prod en conteneurs (docker-compose.prod.yml).
#
# Ce fichier ne concerne PAS la prod OVH actuelle (déploiement SSH), qui lit
# .env.prod + .env.prod.local (voir .github/workflows/deploy.yml).
#
# Usage :
#   cp docker/.env.prod-docker.dist .env.prod-docker
#   (remplacer tous les CHANGE_ME, ne jamais commiter .env.prod-docker)
#   export WEBSERVER_IMAGE=<image>
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Toutes les variables DATABASE_* sont définies ici : sans cela l'application
# retomberait sur le DATABASE_URL de .env.prod (base OVH).

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME

DEFAULT_URI=https://larpmanager.eveoniris.com
CORS_ALLOW_ORIGIN='^https://larpmanager\.eveoniris\.com$'
SERVER_NAME=":80, :443, larpmanager.eveoniris.com"

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=larpm
MYSQL_USER=larpm
MYSQL_PASSWORD=CHANGE_ME

DATABASE_SERVER=database:3306
DATABASE_VERSION=8.4
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${DATABASE_SERVER}/${MYSQL_DATABASE}?serverVersion=${DATABASE_VERSION}&charset=utf8mb4"

MAILER_DSN=CHANGE_ME
